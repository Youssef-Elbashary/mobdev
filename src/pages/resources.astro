---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import EmptyState from '@/components/EmptyState.astro';
import Icon from '@/components/Icon.astro';
import { groupBy, slug, getData } from '@/lib/content';
const items = await getData('resources');
const ORDER = ['Official Docs', 'Tutorials', 'Videos', 'Articles', 'Tools', 'References', 'Cheat Sheets'];
const groups = [...groupBy(items, (i) => i.data.category)].sort((a, b) => ORDER.indexOf(a[0]) - ORDER.indexOf(b[0]));
const host = (h: string) => { try { return new URL(h).hostname.replace(/^www\./, ''); } catch { return ''; } };
---
<Base title="Resources" description="Curated documentation, tutorials, videos and references for the Mobile Development course.">
  <PageHeader eyebrow="Resources" title="Curated,<br/><span class='accent'>not collected.</span>" lead="Official documentation, tutorials, references and cheat sheets chosen for this course. Start with the official docs — they're always the most accurate." crumbs={[{ label: 'resources' }]}>
    <nav class="res-jump" aria-label="Resource categories">{groups.map(([c, l]) => <a href={`#${slug(c)}`} class="chip">{c} <span class="count">{l.length}</span></a>)}</nav>
  </PageHeader>
  <div class="container res-wrap">
    {items.length === 0 && <EmptyState title="Resources are coming soon." path="resources/" />}
    {groups.map(([cat, list]) => (
      <section class="rg" id={slug(cat)}>
        <h2 class="rg-h"><span class="mono">{String(list.length).padStart(2, '0')}</span>{cat}</h2>
        <ul class="rg-list">
          {list.map((r, i) => {
            const ext = r.data.href.startsWith('http');
            return (
              <li data-reveal style={`--d:${i * 40}ms`}>
                <a href={r.data.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} class="res-item">
                  <span class="ri-main">
                    <span class="ri-t">{r.data.title}</span>
                    {r.data.description && <span class="ri-d">{r.data.description}</span>}
                  </span>
                  <span class="ri-src mono">{r.data.source ?? host(r.data.href)}</span>
                  <Icon name={ext ? 'arrow-up-right' : 'arrow'} class="ri-go" />
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .res-jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .res-wrap { padding-block: 48px var(--section-y); display: grid; gap: 56px; }
  .rg { display: grid; gap: 16px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  @media (min-width: 1024px) { .rg { grid-template-columns: 260px 1fr; gap: 48px; } }
  .rg-h { display: flex; gap: 12px; align-items: baseline; font-size: var(--fs-lg); padding-top: 18px; }
  .rg-h .mono { font-size: 12px; color: var(--accent-text); font-weight: 500; letter-spacing: 0; }
  .rg-list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .res-item { display: grid; grid-template-columns: 1fr 20px; gap: 6px 20px; align-items: center; padding: 18px 4px; border-bottom: 1px solid var(--line); transition: padding var(--t-med) var(--ease-out), background var(--t-med); }
  @media (min-width: 720px) { .res-item { grid-template-columns: 1fr auto 20px; } }
  .res-item:hover { padding-left: 12px; background: linear-gradient(90deg, var(--accent-soft), transparent 70%); }
  .ri-main { display: grid; gap: 2px; min-width: 0; }
  .ri-t { font-weight: 550; }
  .ri-d { font-size: 14px; color: var(--text-3); }
  .ri-src { font-size: 11.5px; color: var(--text-3); grid-row: 2; }
  @media (min-width: 720px) { .ri-src { grid-row: auto; } }
  .res-item :global(.ri-go) { width: 18px; height: 18px; color: var(--text-3); grid-row: 1; grid-column: -2; transition: color var(--t-fast), transform var(--t-med) var(--ease-out); }
  .res-item:hover :global(.ri-go) { color: var(--accent-text); transform: translate(2px, -2px); }
</style>
