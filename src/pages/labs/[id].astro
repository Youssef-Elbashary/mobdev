---
/**
 * LAB TEMPLATE — every file in src/content/labs (.md or .mdx) renders through this page.
 * .mdx labs can use the visual lab components listed in `components` below, e.g.
 *   <Part n="1" title="…" time="10 min" />  <Task n="1.1" title="…" time="2 min">…</Task>
 * Parts/Tasks automatically build the header plan, progress tracking and the sidebar tracker.
 */
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Toc from '@/components/Toc.astro';
import ProblemList from '@/components/ProblemList.astro';
import Device from '@/components/Device.astro';
import ReadProgress from '@/components/ReadProgress.astro';
import SplitBar from '@/components/SplitBar.astro';
import { Image } from 'astro:assets';
import { getLabs, pad, inline, slug } from '@/lib/content';
import { parseLabOutline, minutes } from '@/lib/lab';
import '@/styles/lab.css';

// visual components available inside .mdx labs (no import needed in the lab file)
import Part from '@/components/lab/Part.astro';
import Task from '@/components/lab/Task.astro';
import Checkpoint from '@/components/lab/Checkpoint.astro';
import Terminal from '@/components/lab/Terminal.astro';
import Explain from '@/components/lab/Explain.astro';
import Cards from '@/components/lab/Cards.astro';
import ToolGrid from '@/components/lab/ToolGrid.astro';
import TeamCards from '@/components/lab/TeamCards.astro';
import Timeline from '@/components/lab/Timeline.astro';
import FileTree from '@/components/lab/FileTree.astro';
import AppPhone from '@/components/lab/AppPhone.astro';
import AppWalkthrough from '@/components/lab/AppWalkthrough.astro';
import MockScreen from '@/components/lab/MockScreen.astro';
import BeforeAfter from '@/components/lab/BeforeAfter.astro';
import GitFlow from '@/components/lab/GitFlow.astro';
import BranchPerMember from '@/components/lab/BranchPerMember.astro';
import ClickPath from '@/components/lab/ClickPath.astro';
import GhSignup from '@/components/lab/mock/GhSignup.astro';
import GhNewRepo from '@/components/lab/mock/GhNewRepo.astro';
import GhQuickSetup from '@/components/lab/mock/GhQuickSetup.astro';
import GhToken from '@/components/lab/mock/GhToken.astro';
import GcmDialog from '@/components/lab/mock/GcmDialog.astro';
import GhPullRequest from '@/components/lab/mock/GhPullRequest.astro';
import VsCode from '@/components/lab/mock/VsCode.astro';
import CheckinCard from '@/components/lab/CheckinCard.astro';
import RepoSubmit from '@/components/lab/RepoSubmit.astro';
import LabRuntime from '@/components/lab/LabRuntime.astro';
// interactive labs (Lab 02+): live exercises, demos and explanation visuals
import Exercise from '@/components/lab/interactive/Exercise.astro';
import Demo from '@/components/lab/interactive/Demo.astro';
import LabStart from '@/components/lab/interactive/LabStart.astro';
import LabProgress from '@/components/lab/interactive/LabProgress.astro';
import AppStartFlow from '@/components/lab/interactive/AppStartFlow.astro';
import ComponentTree from '@/components/lab/interactive/ComponentTree.astro';
import PropsFlow from '@/components/lab/interactive/PropsFlow.astro';
import StateLoop from '@/components/lab/interactive/StateLoop.astro';
import EffectTimeline from '@/components/lab/interactive/EffectTimeline.astro';
import RnMap from '@/components/lab/interactive/RnMap.astro';
import FlexAxes from '@/components/lab/interactive/FlexAxes.astro';
import FlatListWindow from '@/components/lab/interactive/FlatListWindow.astro';
import ClassMap from '@/components/lab/interactive/ClassMap.astro';
import { EXERCISES as LAB02_EXERCISES } from '@/lab/exercises/lab-02/meta';

const components = {
  Part, Task, Checkpoint, Terminal, Explain, Cards, ToolGrid, TeamCards, Timeline, FileTree, AppPhone, AppWalkthrough, MockScreen, BeforeAfter,
  GitFlow, BranchPerMember, ClickPath, SplitBar, GhSignup, GhNewRepo, GhQuickSetup, GhToken, GcmDialog, GhPullRequest, VsCode,
  RepoSubmit, Exercise, Demo, AppStartFlow, ComponentTree, PropsFlow, StateLoop, EffectTimeline, RnMap, FlexAxes, FlatListWindow, ClassMap,
};

/** exercise lists of interactive labs (by lab id) */
const INTERACTIVE: Record<string, typeof LAB02_EXERCISES> = { 'lab-02': LAB02_EXERCISES };

export async function getStaticPaths() {
  const labs = await getLabs();
  return labs.map((lab, i) => ({ params: { id: lab.id }, props: { lab, prev: labs[i - 1], next: labs[i + 1] } }));
}
const { lab, prev, next } = Astro.props;
const d = lab.data;
const { Content, headings } = await render(lab);

const exercises = d.interactive ? (INTERACTIVE[lab.id] ?? []) : [];
const interactive = exercises.length > 0;
// interactive labs: each <Part> (block) lists its exercises instead of <Task> checkboxes
const outline = parseLabOutline(lab.body).map((p) =>
  interactive ? { ...p, tasks: exercises.filter((e) => String(e.block) === p.n).map((e) => ({ n: String(e.n), title: e.title, id: `ex-${e.id}` })) } : p,
);
const tasks = outline.flatMap((p) => p.tasks);
const isMission = tasks.length > 0;
const unit = interactive ? 'exercises' : 'tasks';
const totalMin = outline.reduce((a, p) => a + minutes(p.time), 0);
const PART_COLORS = ['var(--accent)', '#7cb1ff', '#ffb547', '#ff8ad8', '#5ee0d2'];

const sections = [
  d.objectives.length && { depth: 2, slug: 'objectives', text: 'Learning objectives' },
  d.prerequisites.length && { depth: 2, slug: 'requirements', text: 'Requirements' },
  ...headings.filter((h) => h.depth === 2),
  d.expectedResult && { depth: 2, slug: 'expected-result', text: 'Expected result' },
  d.troubleshooting.length && { depth: 2, slug: 'troubleshooting', text: 'Troubleshooting' },
  d.submission.length && { depth: 2, slug: 'submission', text: 'Submission' },
  d.extraChallenge && { depth: 2, slug: 'extra-challenge', text: 'Extra challenge' },
].filter(Boolean) as { depth: number; slug: string; text: string }[];
---
<Base title={`Lab ${pad(d.number)} — ${d.title}`} description={d.description}>
  <ReadProgress />
  <header class="page-head lab-head">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">~</a><span aria-hidden="true">/</span><a href="/labs">labs</a><span aria-hidden="true">/</span><span aria-current="page">{lab.id}</span></nav>
      <div class="lh-grid">
        <div>
          <p class="lh-no mono" data-reveal>LAB<span>{pad(d.number)}</span></p>
          <h1 class="h-1 lh-title" data-reveal style="--d:60ms">{d.title}</h1>
          <p class="lead mt-6" data-reveal style="--d:120ms">{d.description}</p>
          <div class="lh-chips" data-reveal style="--d:160ms">
            <span class={`badge badge-${d.difficulty.toLowerCase()}`}><span class="dot"></span>{d.difficulty}</span>
            <span class="badge"><Icon name="clock" size={12} /> {d.estimatedTime}</span>
            {d.skills.map((s) => <span class="tag">{slug(s)}</span>)}
          </div>
        </div>

        {isMission ? (
          <div class="dash" data-reveal style="--d:200ms" data-lab-dash>
            <div class="ring" aria-hidden="true">
              <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52" class="rb" /><circle cx="60" cy="60" r="52" class="rf" data-ring pathLength="100" /></svg>
              <div class="ring-c"><b data-pct>0</b><small>%</small></div>
            </div>
            <div class="dash-t">
              <p class="mono dash-k">Your progress</p>
              <p class="dash-v"><b data-done>0</b> / {tasks.length} {unit}</p>
              <p class="dash-s mono">{outline.length} {interactive ? 'blocks' : 'parts'} · {totalMin} min</p>
              {!interactive && <button class="dash-reset mono" data-lab-reset type="button">reset</button>}
            </div>
          </div>
        ) : (
          <dl class="lh-meta" data-reveal style="--d:180ms">
            <div><dt>Difficulty</dt><dd>{d.difficulty}</dd></div>
            <div><dt>Estimated time</dt><dd class="mono">{d.estimatedTime}</dd></div>
          </dl>
        )}
      </div>

      {isMission && (
        <nav class="plan" data-reveal aria-label="Lab plan">
          <p class="plan-k mono">Session plan · {totalMin} min</p>
          <ol class="plan-bar">
            {outline.map((p, i) => (
              <li style={`flex:${Math.max(minutes(p.time), 4)}; --c:${PART_COLORS[i % PART_COLORS.length]}; --i:${i}`}>
                <a href={`#${p.id}`} data-plan-part={p.n}>
                  <span class="pb-fill" aria-hidden="true"></span>
                  <span class="pb-n mono">{interactive ? 'BLOCK' : 'PART'} {pad(Number(p.n))}</span>
                  <span class="pb-t">{p.title}</span>
                  <span class="pb-m mono">{p.time} · {p.tasks.length} {p.tasks.length === 1 ? unit.slice(0, -1) : unit}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </header>

  {interactive && <LabProgress />}
  <div class:list={['container doc', { 'is-interactive': interactive }]} data-lab={lab.id} data-total={tasks.length} data-lab-interactive={interactive ? lab.id : undefined}>
    <article class="doc-main">
      {isMission && <LabStart id={lab.id} lab={`Lab ${pad(d.number)}`} />}

      {(d.objectives.length > 0 || d.prerequisites.length > 0) && (
        <section class="brief" data-reveal>
          {d.objectives.length > 0 && (
            <div class="brief-col">
              <p class="brief-k mono" id="objectives"><Icon name="target" size={14} /> By the end you will</p>
              <ul>{d.objectives.map((o, i) => <li class="stg" style={`--i:${i}`}><span class="bi ok" aria-hidden="true">✓</span><span set:html={inline(o)} /></li>)}</ul>
            </div>
          )}
          {d.prerequisites.length > 0 && (
            <div class="brief-col need">
              <p class="brief-k mono" id="requirements"><Icon name="layers" size={14} /> You need</p>
              <ul>{d.prerequisites.map((p, i) => <li class="stg" style={`--i:${i + 3}`}><span class="bi" aria-hidden="true">→</span><span set:html={inline(p)} /></li>)}</ul>
            </div>
          )}
        </section>
      )}

      <section class="block prose lab-prose">
        <Content components={components} />
      </section>

      {isMission && (
        <section class="done-banner" data-lab-complete hidden>
          <span class="db-ic" aria-hidden="true">🎉</span>
          <div>
            <p class="db-t">Lab {pad(d.number)} complete</p>
            <p class="muted">All {tasks.length} {unit} done. Nice work.</p>
          </div>
        </section>
      )}

      {d.expectedResult && (
        <section class="block">
          <h2 class="block-title" id="expected-result">Expected result</h2>
          <div class="er panel">
            <div class="er-device">
              {d.expectedResult.image ? (
                <Device label="Expected result screenshot"><Image src={d.expectedResult.image} alt="Expected result" class="er-img" /></Device>
              ) : (
                <Device label={`Expected result: ${d.expectedResult.description}`}>
                  <div class="er-screen">
                    {(d.expectedResult.screen ?? ['Your app', 'will look like this']).map((line, i) => <p class={i === 0 ? 'er-h' : 'er-row'}>{line}</p>)}
                  </div>
                </Device>
              )}
            </div>
            <div class="er-text">
              <p class="eyebrow">What you should see</p>
              <p set:html={inline(d.expectedResult.description)} />
            </div>
          </div>
        </section>
      )}

      {d.troubleshooting.length > 0 && (
        <section class="block stuck">
          <h2 class="block-title" id="troubleshooting"><span class="stuck-ic" aria-hidden="true"><Icon name="bug" size={18} /></span>Stuck?</h2>
          <ProblemList items={d.troubleshooting} />
          <p class="faint mt-4" style="font-size:14px">Still stuck? Search the <a href="/troubleshooting" class="accent">troubleshooting center</a> or ask your TA.</p>
        </section>
      )}

      {d.submission.length > 0 && (
        <section class="block">
          <h2 class="block-title" id="submission">Submission</h2>
          <div class="submit panel">
            <ul class="check-list">{d.submission.map((s) => <li set:html={inline(s)} />)}</ul>
          </div>
        </section>
      )}

      {d.extraChallenge && (
        <section class="block">
          <div class="challenge">
            <span class="badge badge-optional"><span class="dot"></span>Optional</span>
            <h2 class="h-3" id="extra-challenge">Extra challenge</h2>
            <p set:html={inline(d.extraChallenge)} />
          </div>
        </section>
      )}

      {d.resources.length > 0 && (
        <section class="block">
          <h2 class="block-title h-4" id="resources">Resources</h2>
          <ul class="dash-list">{d.resources.map((r) => <li><a href={r.href} target="_blank" rel="noopener" class="accent">{r.label}</a></li>)}</ul>
        </section>
      )}

      {isMission && <CheckinCard lab={lab.id} label={`Lab ${pad(d.number)}`} />}

      <nav class="pn" aria-label="Lab navigation">
        {prev ? (
          <a href={`/labs/${prev.id}`} class="pn-a"><span class="mono faint">← Lab {pad(prev.data.number)}</span><span>{prev.data.title}</span></a>
        ) : <a href="/labs" class="pn-a"><span class="mono faint">← All labs</span><span>Labs</span></a>}
        {next ? (
          <a href={`/labs/${next.id}`} class="pn-a next"><span class="mono faint">Lab {pad(next.data.number)} →</span><span>{next.data.title}</span></a>
        ) : (
          <a href="/commands" class="pn-a next"><span class="mono faint">Keep handy →</span><span>Command Handbook</span></a>
        )}
      </nav>
    </article>

    <aside class="doc-aside">
      {isMission ? (
        <nav class="toc tracker" aria-label="Lab tracker">
          <p class="toc-title">Lab {pad(d.number)} tracker</p>
          <div class="tr-bar" aria-hidden="true"><i data-track-bar></i></div>
          <ol>
            {outline.map((p) => (
              <li class="tr-part">
                <a href={`#${p.id}`} class="tr-p"><span class="mono">{pad(Number(p.n))}</span>{p.title}</a>
                <ol>
                  {p.tasks.map((t) => (
                    <li><a href={`#${t.id}`} data-track={t.n}><span class="tr-dot" aria-hidden="true"></span><span class="tr-n mono">{t.n}</span>{t.title}</a></li>
                  ))}
                </ol>
              </li>
            ))}
            {d.troubleshooting.length > 0 && <li class="tr-part"><a href="#troubleshooting" class="tr-p"><span class="mono">?</span>Stuck?</a></li>}
          </ol>
        </nav>
      ) : (
        <Toc items={sections} title={`Lab ${pad(d.number)}`} />
      )}
      <div class="aside-card">
        <p class="mono faint" style="font-size:11px">NEED A COMMAND?</p>
        <button class="btn btn-ghost btn-sm w-full mt-2" data-search-open data-search-query=""><Icon name="search" /> Search</button>
      </div>
    </aside>
  </div>
  <LabRuntime />
</Base>

<style>
  .lab-head { padding-bottom: 48px; }
  .lh-grid { display: grid; gap: 32px; align-items: end; }
  @media (min-width: 1024px) { .lh-grid { grid-template-columns: 1fr 340px; gap: 64px; } }
  .lh-no { font-size: 12px; letter-spacing: 0.14em; color: var(--text-3); display: flex; align-items: baseline; gap: 10px; }
  .lh-no span { font-family: var(--font-display); font-size: 64px; letter-spacing: -0.05em; font-weight: 650; color: var(--accent-text); line-height: 0.9; }
  .lh-title { margin-top: 20px; max-width: 18ch; font-size: clamp(2.3rem, 1.4rem + 3.4vw, 4.4rem); }
  .lh-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 24px; }
  .lh-chips .badge { display: inline-flex; align-items: center; gap: 6px; }
  .lh-me { margin-top: 14px; }
  .lh-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  .lh-meta > div { background: var(--surface); padding: 16px; display: grid; gap: 8px; }
  .lh-meta dt { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }

  /* progress dashboard */
  .dash { display: flex; align-items: center; gap: 20px; padding: 20px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface); box-shadow: var(--shadow-md); }
  .ring { position: relative; width: 104px; height: 104px; flex: none; }
  .ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring .rb { fill: none; stroke: var(--line); stroke-width: 10; }
  .ring .rf { fill: none; stroke: var(--accent); stroke-width: 10; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 900ms var(--ease-out); }
  :global(:root[data-theme='light']) .ring .rf { stroke: var(--accent-text); }
  .ring-c { position: absolute; inset: 0; display: grid; place-items: center; grid-auto-flow: column; align-content: center; justify-content: center; font-family: var(--font-display); }
  .ring-c b { font-size: 28px; font-weight: 700; letter-spacing: -0.04em; }
  .ring-c small { font-size: 13px; color: var(--text-3); align-self: end; margin-bottom: 6px; }
  .dash-k { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
  .dash-v { font-size: 1.15rem; font-weight: 600; margin-top: 2px; }
  .dash-v b { font-family: var(--font-display); font-size: 1.6rem; color: var(--accent-text); }
  .dash-s { font-size: 12px; color: var(--text-3); margin-top: 2px; }
  .dash-reset { margin-top: 8px; font-size: 11px; color: var(--text-3); text-decoration: underline; text-underline-offset: 3px; }
  .dash-reset:hover { color: var(--danger); }

  /* session plan bar */
  .plan { margin-top: 40px; }
  .plan-k { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); margin-bottom: 10px; }
  .plan-bar { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 8px; }
  .plan-bar li { min-width: 0; }
  .plan-bar a { position: relative; display: grid; gap: 2px; height: 100%; padding: 12px 14px 12px; border-radius: 12px; border: 1px solid color-mix(in oklab, var(--c) 45%, var(--line)); background: var(--surface); overflow: hidden; transition: transform var(--t-med) var(--ease-out), border-color var(--t-med); }
  .plan-bar a:hover { transform: translateY(-2px); border-color: var(--c); }
  .pb-fill { position: absolute; inset: 0; background: linear-gradient(90deg, color-mix(in oklab, var(--c) 28%, transparent), color-mix(in oklab, var(--c) 10%, transparent)); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 900ms var(--ease-out); }
  .plan-bar a::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); }
  :global(:root[data-theme='light']) .plan-bar li:first-child a::before { background: var(--accent-text); }
  .pb-n, .pb-t, .pb-m { position: relative; }
  .pb-n { font-size: 10px; letter-spacing: 0.12em; color: var(--text-3); }
  .pb-t { font-weight: 650; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pb-m { font-size: 11px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .plan .plan-bar li { opacity: 0; transform: translateY(10px) scaleX(0.92); transform-origin: left; }
  .plan.in .plan-bar li { animation: plan-in 700ms var(--ease-out) forwards; animation-delay: calc(250ms + var(--i) * 150ms); }
  @keyframes plan-in { to { opacity: 1; transform: none; } }
  @media (max-width: 719px) {
    .plan-bar { grid-template-columns: 1fr; }
    .pb-t { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) { .plan .plan-bar li { opacity: 1; transform: none; animation: none; } }

  /* mission brief */
  .brief { display: grid; gap: 12px; margin-bottom: 56px; }
  @media (min-width: 760px) { .brief { grid-template-columns: 1.2fr 1fr; } }
  .brief-col { padding: 20px; border-radius: var(--r-lg); border: 1px solid var(--line); background: linear-gradient(160deg, var(--accent-soft), var(--surface) 55%); }
  .brief-col.need { background: var(--surface); }
  .brief-k { display: flex; align-items: center; gap: 8px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .brief ul { list-style: none; padding: 0; display: grid; gap: 8px; }
  .brief li { display: grid; grid-template-columns: 22px 1fr; gap: 8px; color: var(--text); font-size: 15px; }
  .bi { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; margin-top: 2px; background: var(--surface-3); color: var(--text-2); }
  .bi.ok { background: var(--accent); color: var(--accent-ink); }

  .lab-prose { margin-top: 0 !important; }

  /* completion */
  .done-banner { display: flex; align-items: center; gap: 16px; margin-top: 40px; padding: 20px 24px; border-radius: var(--r-lg); border: 1px solid var(--ok); background: linear-gradient(135deg, var(--ok-soft), transparent); animation: stg-in 700ms var(--ease-out); }
  .db-ic { font-size: 36px; }
  .db-t { font-family: var(--font-display); font-weight: 650; font-size: var(--fs-lg); }

  .stuck .block-title { display: flex; align-items: center; gap: 12px; }
  .stuck-ic { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--warn-soft); color: var(--warn); }

  /* tracker */
  .tracker > ol { border-left: 0 !important; display: grid; gap: 10px; }
  .tr-bar { height: 4px; border-radius: 4px; background: var(--line); overflow: hidden; margin-bottom: 14px; }
  .tr-bar i { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 700ms var(--ease-out); }
  .tr-part > ol { list-style: none; padding: 0; margin-top: 4px; border-left: 1px solid var(--line); }
  .tracker a.tr-p { display: flex; gap: 8px; align-items: baseline; font-weight: 600; color: var(--text-2); padding: 4px 0; border: 0; margin: 0; }
  .tracker a.tr-p .mono { font-size: 11px; color: var(--accent-text); }
  .tracker .tr-part > ol a { display: grid; grid-template-columns: 12px auto 1fr; gap: 8px; align-items: center; font-size: 13px; padding: 4px 0 4px 12px; }
  .tr-dot { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--line-2); transition: all 300ms var(--ease-out); }
  .tr-n { font-size: 10.5px; color: var(--text-3); }
  .tracker a.done { color: var(--text-3); }
  .tracker a.done .tr-dot { background: var(--ok); border-color: var(--ok); box-shadow: 0 0 0 3px var(--ok-soft); }

