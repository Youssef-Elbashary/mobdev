---
/**
 * The platform's front door: students choose their module first.
 * First visit: onboarding (year → specialization → optional modules). Then "Your modules": core modules
 * for their year and specialization plus the optional ones they chose. Answers are saved to the student's
 * account when signed in, otherwise in this browser (signing in is optional).
 */
import Base from '@/layouts/Base.astro';
import { hubData } from '@/lib/accounts/hub';

export const prerender = false;
Astro.response.headers.set('cache-control', 'public, max-age=0, s-maxage=30, stale-while-revalidate=120');
const { settings, cards } = await hubData();
const json = JSON.stringify({ years: settings.years, specializations: settings.specializations, categories: settings.categories, activeSemester: settings.activeSemester, specFrom: settings.specFrom, cards }).replace(/</g, '\\u003c');
---
<Base title="Choose your module" description="Pick your module to open its labs, sessions and progress.">
  <section class="hub" data-hub>
    <script type="application/json" data-hub-data set:html={json} />
    <div class="hub-sky" aria-hidden="true">
      <div class="hub-grid"></div>
      <div class="hub-orb a"></div><div class="hub-orb b"></div><div class="hub-orb c"></div>
      <svg class="hub-rings" viewBox="0 0 600 600"><circle cx="300" cy="300" r="180" /><circle cx="300" cy="300" r="240" /><circle cx="300" cy="300" r="295" /></svg>
    </div>

    <div class="container hub-in">
      <header class="hub-head">
        <p class="hub-k mono"><span class="hub-dot"></span> Learning platform · {settings.activeSemester} is active · {cards.length} modules</p>
        <h1 class="hub-t" data-hub-title>Choose your <span>module</span></h1>
        <p class="hub-sub" data-hub-sub>Tell us where you are in your degree and we'll line up your modules.</p>
        <div class="hub-who" data-hub-who hidden></div>
      </header>

      <!-- onboarding -->
      <div class="ob glass" data-ob hidden>
        <ol class="ob-steps mono" aria-hidden="true">
          <li data-step-dot="1"><span>01</span> Year</li>
          <li data-step-dot="2"><span>02</span> Specialization</li>
          <li data-step-dot="3"><span>03</span> Optional modules</li>
        </ol>
        <div class="ob-step" data-step="1">
          <h2>Which year are you in?</h2>
          <div class="ob-pills" data-pills="year"></div>
        </div>
        <div class="ob-step" data-step="2" hidden>
          <h2>What's your specialization?</h2>
          <div class="ob-pills" data-pills="specialization"></div>
          <p class="ob-empty" data-spec-general hidden></p>
        </div>
        <div class="ob-step" data-step="3" hidden>
          <h2>Which optional modules did you choose?</h2>
          <p class="ob-note" data-opt-note>Tick the optional modules you registered for. Other modules are added by your module leader's invitation.</p>
          <div class="ob-opts" data-opts></div>
        </div>
        <div class="ob-foot">
          <button type="button" class="ob-back" data-ob-back hidden>← Back</button>
          <span class="ob-msg" data-ob-msg role="status"></span>
          <button type="button" class="btn btn-primary ob-next" data-ob-next disabled>Next →</button>
        </div>
      </div>

      <!-- my modules -->
      <section class="mine" data-mine hidden>
        <div class="mine-bar">
          <p class="mono mine-chips" data-mine-chips></p>
          <button type="button" class="mine-edit mono" data-edit>change answers</button>
        </div>
        <div class="mine-grid" data-mine-grid></div>
        <div class="later" data-later hidden><h2 class="later-h mono">Your modules in other semesters</h2><div class="mine-grid small" data-later-grid></div></div>
        <div class="find">
          <div class="find-bar">
            <h2>Find a module</h2>
            <input class="find-q" type="search" placeholder="Search by name, code or description" data-find-q aria-label="Search modules" />
          </div>
          <div class="find-filters">
            <select class="find-sel" data-find-year aria-label="Year"><option value="">All years</option>{settings.years.map((y) => <option>{y}</option>)}</select>
            <select class="find-sel" data-find-sem aria-label="Semester"><option value="">Both semesters</option><option>Semester 1</option><option>Semester 2</option></select>
            <select class="find-sel" data-find-spec aria-label="Specialization"><option value="">Any specialization</option>{settings.specializations.map((s) => <option>{s}</option>)}</select>
            <select class="find-sel" data-find-cat aria-label="Category"><option value="">Any category</option>{settings.categories.map((c) => <option>{c.name}</option>)}</select>
            <a class="find-all mono" href="/modules">Full directory →</a>
          </div>
          <div data-others-grid></div>
          <p class="find-none" data-find-none hidden>No modules match your search.</p>
        </div>
      </section>
    </div>
  </section>
</Base>

<style is:global>
  .hub { --g1: #c8ff4d; --g2: #7cb1ff; --g3: #b69cff; position: relative; min-height: 100dvh; overflow: hidden; isolation: isolate; padding: calc(var(--nav-h) + 48px) 0 96px; background: var(--hero-bg); color: var(--hero-text); }
  :root[data-theme='light'] .hub { --g1: #9fd400; --g2: #3d7be0; --g3: #7a5ce0; }
  .hub-sky { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hub-grid { position: absolute; inset: -50% -10% 0; background-image: linear-gradient(var(--hero-grid) 1px, transparent 1px), linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px); background-size: 64px 64px;
    transform: perspective(700px) rotateX(58deg) translateY(10%); transform-origin: 50% 100%; mask-image: linear-gradient(transparent 10%, #000 60%); animation: hub-grid 14s linear infinite; }
  @keyframes hub-grid { to { background-position: 0 64px, 0 0; } }
  .hub-orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; animation: hub-float 16s ease-in-out infinite; }
  .hub-orb.a { width: 520px; height: 520px; right: -120px; top: -160px; background: radial-gradient(circle, color-mix(in oklab, var(--g1) 70%, transparent), transparent 65%); }
  .hub-orb.b { width: 460px; height: 460px; left: -160px; top: 30%; background: radial-gradient(circle, color-mix(in oklab, var(--g2) 60%, transparent), transparent 65%); animation-delay: -5s; }
  .hub-orb.c { width: 380px; height: 380px; right: 20%; bottom: -160px; background: radial-gradient(circle, color-mix(in oklab, var(--g3) 55%, transparent), transparent 65%); animation-delay: -9s; }
  :root[data-theme='light'] .hub-orb { opacity: .35; }
  @keyframes hub-float { 50% { transform: translate(30px, -24px) scale(1.06); } }
  .hub-rings { position: absolute; width: 760px; right: -220px; top: -120px; opacity: .5; animation: hub-spin 60s linear infinite; }
  .hub-rings circle { fill: none; stroke: var(--hero-line); stroke-width: 1; stroke-dasharray: 2 10; }
  @keyframes hub-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .hub-grid, .hub-orb, .hub-rings, .hub-dot { animation: none !important; } }

  .hub-in { display: grid; gap: 36px; }
  .hub-k { display: inline-flex; align-items: center; gap: 10px; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--hero-accent); }
  .hub-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hero-accent); box-shadow: 0 0 12px var(--hero-accent); animation: pulse-ring 2s infinite; }
  .hub-t { margin-top: 18px; font-size: clamp(3rem, 1.4rem + 6.4vw, 7.4rem); line-height: .9; letter-spacing: -.055em; font-weight: 700; }
  .hub-t span { background: linear-gradient(100deg, var(--g1), var(--g2) 55%, var(--g3)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hub-sub { margin-top: 20px; max-width: 56ch; font-size: var(--fs-md); color: var(--hero-lead); }
  .hub-who { margin-top: 18px; display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 8px 8px 8px 14px; border-radius: 999px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-bg) 60%, transparent); backdrop-filter: blur(10px); font-size: 13.5px; color: var(--hero-lead); }
  .hub-who b { color: var(--hero-text); }
  .hub-who a, .hub-who button { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--hero-line); background: none; color: var(--hero-text); font-size: 12.5px; cursor: pointer; }
  .hub-who a.pri { background: var(--hero-accent); border-color: var(--hero-accent); color: var(--hero-bg); font-weight: 600; }

  .ob { max-width: 900px; padding: clamp(22px, 4vw, 40px); display: grid; gap: 22px; }
  .ob-steps { list-style: none; padding: 0; display: flex; gap: 8px; flex-wrap: wrap; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--hero-dim); }
  .ob-steps li { display: flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 999px; border: 1px solid var(--hero-line); transition: all var(--t-fast); }
  .ob-steps li span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: color-mix(in oklab, var(--hero-text) 8%, transparent); }
  .ob-steps li.on { color: var(--hero-text); border-color: var(--hero-accent); box-shadow: 0 0 20px -6px var(--hero-accent); }
  .ob-steps li.on span, .ob-steps li.done span { background: var(--hero-accent); color: var(--hero-bg); }
  .ob-step h2 { font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem); letter-spacing: -.035em; }
  .ob-pills { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; }
  .ob-pill { padding: 14px 20px; border-radius: 16px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-text) 4%, transparent); color: var(--hero-text); font: 600 15px var(--font-body); cursor: pointer; transition: transform var(--t-fast), border-color var(--t-fast), box-shadow var(--t-fast), background var(--t-fast); }
  .ob-pill:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--hero-accent) 60%, var(--hero-line)); }
  .ob-pill[aria-pressed='true'] { border-color: var(--hero-accent); background: color-mix(in oklab, var(--hero-accent) 16%, transparent); box-shadow: 0 0 0 1px var(--hero-accent), 0 10px 30px -12px var(--hero-accent); }
  .ob-note { margin-top: 8px; color: var(--hero-lead); font-size: 14px; }
  .ob-opts { margin-top: 18px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .ob-opt { position: relative; display: grid; gap: 4px; text-align: left; padding: 16px 16px 16px 50px; border-radius: 16px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-text) 4%, transparent); color: var(--hero-text); cursor: pointer; transition: border-color var(--t-fast), background var(--t-fast); }
  .ob-opt::before { content: ''; position: absolute; left: 16px; top: 18px; width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--hero-dim); }
  .ob-opt[aria-pressed='true'] { border-color: var(--c); background: color-mix(in oklab, var(--c) 14%, transparent); }
  .ob-opt[aria-pressed='true']::before { background: var(--c); border-color: var(--c); box-shadow: inset 0 0 0 3px color-mix(in oklab, var(--hero-bg) 70%, transparent); }
  .ob-opt b { font-size: 15px; }
  .ob-opt small { font-size: 12px; color: var(--hero-dim); font-family: var(--font-mono); }
  .ob-empty { color: var(--hero-lead); font-size: 14.5px; padding: 18px; border-radius: 14px; border: 1px dashed var(--hero-line); }
  .ob-foot { display: flex; align-items: center; gap: 14px; }
  .ob-back { border: 0; background: none; color: var(--hero-lead); cursor: pointer; font-size: 14px; }
  .ob-msg { flex: 1; font-size: 13px; color: var(--hero-danger); }
  .ob-next { min-width: 140px; }

  .mine { display: grid; gap: 22px; }
  .mine-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mine-chips { display: flex; flex-wrap: wrap; gap: 8px; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; }
  .mine-chips span { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-lead); background: color-mix(in oklab, var(--hero-bg) 60%, transparent); }
  .mine-edit { border: 0; background: none; color: var(--hero-accent); cursor: pointer; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; }
  .mine-grid { display: grid; gap: 18px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
  .mcard { --c: var(--g1); position: relative; display: grid; gap: 12px; align-content: start; min-height: 240px; padding: 26px; border-radius: 24px; overflow: hidden; color: var(--hero-text); isolation: isolate;
    border: 1px solid color-mix(in oklab, var(--c) 35%, var(--hero-line)); background: color-mix(in oklab, var(--hero-bg) 50%, transparent); backdrop-filter: blur(14px);
    transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out), border-color 300ms; animation: mcard-in .6s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes mcard-in { from { opacity: 0; transform: translateY(18px); } }
  .mcard::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--c) 50%, transparent), transparent 65%); z-index: -1; opacity: .55; transition: opacity 300ms; }
  .mcard:hover { transform: translateY(-6px); border-color: var(--c); box-shadow: 0 30px 60px -30px color-mix(in oklab, var(--c) 70%, transparent), 0 0 0 1px var(--c); }
  .mcard:hover::after { opacity: .9; }
  .mcard-top { display: flex; justify-content: space-between; gap: 8px; font: 500 11px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--hero-dim); }
  .mcard-tag { padding: 3px 9px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--c) 50%, transparent); color: var(--hero-text); }
  .mcard h3 { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem); letter-spacing: -.04em; line-height: 1; }
  .mcard p { color: var(--hero-lead); font-size: 14.5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .mcard-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font: 500 12px var(--font-mono); color: var(--hero-dim); }
  .mcard-go { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--c); color: #0b0d10; font-size: 18px; transition: transform 300ms var(--ease-out); }
  .mcard:hover .mcard-go { transform: rotate(-45deg) scale(1.08); }
  .mine-grid.small .mcard { min-height: 0; padding: 20px; }
  .mine-grid.small .mcard h3 { font-size: 1.3rem; }
  .find { display: grid; gap: 16px; margin-top: 26px; }
  .find-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; }
  .find-bar h2 { font-size: clamp(1.4rem, 1rem + 1vw, 2rem); letter-spacing: -.035em; }
  .find-q { width: min(100%, 420px); height: 48px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-bg) 60%, transparent);
    color: var(--hero-text); font: 15px var(--font-body); backdrop-filter: blur(10px); }
  .find-q:focus { outline: none; border-color: var(--hero-accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--hero-accent) 20%, transparent), 0 0 30px -10px var(--hero-accent); }
  .find-none { color: var(--hero-lead); }
  .find-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .find-sel { height: 42px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--hero-line); background: color-mix(in oklab, var(--hero-bg) 70%, transparent); color: var(--hero-text); font: 13.5px var(--font-body); }
  .find-sel:focus { outline: none; border-color: var(--hero-accent); }
  .find-all { margin-left: auto; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--hero-accent); }
  .find-group { display: grid; gap: 12px; margin-top: 18px; }
  .find-gh { display: flex; align-items: baseline; gap: 10px; font-size: 1.3rem; letter-spacing: -.03em; padding-bottom: 8px; border-bottom: 1px solid var(--hero-line); }
  .find-gh small { font: 500 11px var(--font-mono); letter-spacing: .08em; color: var(--hero-dim); }
  .find-chips { display: flex; flex-wrap: wrap; gap: 5px; font: 500 10.5px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
  .find-chips span { padding: 3px 8px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-lead); }
  .mstate { font: 600 10.5px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--hero-line); color: var(--hero-lead); }
  .mstate.locked::before { content: '🔒 '; }
  .mstate.add, .mstate.mine { border-color: var(--hero-accent); color: var(--hero-accent); background: none; }
  .mstate.add { cursor: pointer; }
  .later { display: grid; gap: 14px; }
  .later-h { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--hero-lead); }
  .later .mcard { opacity: .72; }
  .mine-none { padding: 28px; border-radius: 20px; border: 1px dashed var(--hero-line); color: var(--hero-lead); }
</style>

<script>
  import { GENERAL, hasSpecialization, inSemester, type Semester } from '@/lib/accounts/core';
  type Card = { slug: string; code: string; title: string; term: string; description: string; color: string; href: string; labs: number; builtIn: boolean; category: string; kind: 'core' | 'elective'; open: boolean; years: string[]; specializations: string[]; semester: 'Both' | Semester };
  type Profile = { year: string; specialization: string; modules: string[] };
  type Me = { user: { name: string; role: string; studentId: string | null; profile: Profile } | null; staff: boolean; doctor: boolean; accounts: boolean; enrolled: string[]; staffModules: Record<string, string>; builderModules: string[] };

  const KEY = 'mdx:profile';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const has = (list: string[], v: string) => !list.length || list.some((x) => x.toLowerCase() === v.toLowerCase());
  /** Students choose only the built-in course (an optional module for every specialization); everything else is by invitation. */
  // "General" students (before their specialization starts) match only modules open to every specialization
  const fitsSpec = (m: Card, spec: string) => !m.specializations.length || (spec !== GENERAL && has(m.specializations, spec));
  /** an open elective a student may add for their year and specialization (Mobile Development by default) */
  const selfEnrol = (m: Card, p: Pick<Profile, 'year' | 'specialization'>) => m.open && m.kind === 'elective' && has(m.years, p.year) && fitsSpec(m, p.specialization);
  const optionalFor = (cards: Card[], p: Profile) => cards.filter((m) => selfEnrol(m, p));
  let membership = { enrolled: [] as string[], staff: {} as Record<string, string> };
  let builderModules = new Set<string>();
  const forMe = (m: Card, p: Profile) => p.modules.includes(m.slug) || membership.enrolled.includes(m.slug) || Boolean(membership.staff[m.slug]) || (m.open && m.kind === 'core' && has(m.years, p.year) && fitsSpec(m, p.specialization));
  const local = {
    get(): Profile | null { try { const p = JSON.parse(localStorage.getItem(KEY) ?? 'null'); return p && p.year ? p : null; } catch { return null; } },
    set(p: Profile) { try { localStorage.setItem(KEY, JSON.stringify(p)); } catch { /* private mode */ } },
  };

  function card(m: Card, i: number) {
    const href = builderModules.has(m.slug) ? `/admin/builder/${encodeURIComponent(m.slug)}` : m.href;
    return `<a class="mcard" href="${esc(href)}" style="--c:${esc(m.color)};--i:${i}" data-module="${esc(m.slug)}">
      <span class="mcard-top"><span>${esc(m.code || 'Module')}</span><span class="mcard-tag">${esc(m.category)}${m.open ? ' · open' : ' · by invitation'}</span></span>
      <h3>${esc(m.title)}</h3>
      ${m.description ? `<p>${esc(m.description)}</p>` : ''}
      <span class="mcard-foot"><span>${m.labs} lab${m.labs === 1 ? '' : 's'}${m.term ? ` · ${esc(m.term)}` : ''}</span><span class="mcard-go" aria-hidden="true">→</span></span>
    </a>`;
  }

  async function init() {
    const root = document.querySelector<HTMLElement>('[data-hub]');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = '1';
    const data = JSON.parse(root.querySelector('[data-hub-data]')!.textContent!) as { years: string[]; specializations: string[]; activeSemester: Semester; specFrom: { year: string; semester: Semester }; cards: Card[] };
    const specialized = (year: string) => hasSpecialization(data, year, data.activeSemester);
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const ob = $('[data-ob]'), mine = $('[data-mine]'), who = $('[data-hub-who]');
    const me: Me = await fetch('/api/auth/me', { cache: 'no-store' }).then((r) => r.json()).catch(() => ({ user: null, staff: false, doctor: false, accounts: false, enrolled: [], staffModules: {}, builderModules: [] }));
    membership = { enrolled: me.enrolled ?? [], staff: me.staffModules ?? {} };
    builderModules = new Set(me.builderModules ?? []);
    const student = me.user?.role === 'student' ? me.user : null;
    let profile: Profile | null = student?.profile?.year ? student.profile : local.get();
    // a choice saved in this browser can only hold modules students may pick themselves
    if (profile) profile = { ...profile, modules: profile.modules.filter((slug) => data.cards.some((c) => c.slug === slug && selfEnrol(c, profile!))) };

    // who am I
    who.hidden = false;
    if (me.user) {
      who.innerHTML = `Signed in as <b>${esc(me.user.name)}</b> · ${esc(me.user.role === 'ta' ? 'TA' : me.user.role)}
        <a href="/account">Profile</a>${me.staff ? '<a href="/admin">Admin</a>' : ''}${me.doctor ? '<a href="/admin/builder">Builder</a><a href="/admin/accounts">Accounts</a>' : ''}
        <button type="button" data-logout>Sign out</button>`;
      who.querySelector('[data-logout]')!.addEventListener('click', async () => { await fetch('/api/auth/logout', { method: 'POST' }); try { sessionStorage.removeItem('mdx:me'); } catch { /* ignore */ } location.reload(); });
    } else {
      who.innerHTML = `Signing in is optional. Without an account, you type your name and ID in each lab.
        ${me.accounts ? '<a href="/login" class="pri">Sign in</a><a href="/login#signup">Create account</a>' : ''}`;
    }

    const showMine = (p: Profile) => {
      ob.hidden = true;
      mine.hidden = false;
      $('[data-hub-title]').innerHTML = 'Your <span>modules</span>';
      $('[data-hub-sub]').textContent = 'Open a module to see its labs. Your TA starts each lab session; you sign in to the lab with your name and ID.';
      $('[data-mine-chips]').innerHTML = [p.year, data.activeSemester, p.specialization === GENERAL ? 'General (no specialization yet)' : p.specialization, `${p.modules.length} optional`,
        // without an account these answers live only in this browser: say so, so a shared computer doesn't look like "mine"
        ...(me.user ? [] : ['saved in this browser · not signed in'])].map((t) => `<span>${esc(t)}</span>`).join('');
      const all = data.cards.filter((m) => forMe(m, p));
      const mineCards = all.filter((m) => inSemester(m, data.activeSemester));
      const later = all.filter((m) => !inSemester(m, data.activeSemester));
      $('[data-later]').hidden = !later.length;
      $('[data-later-grid]').innerHTML = later.map(card).join('');
      $('[data-mine-grid]').innerHTML = mineCards.length ? mineCards.map(card).join('') : '<p class="mine-none">You aren\'t in any module yet. Choose Mobile Development as an optional module, or ask your module leader for an invitation.</p>';
      renderFind(p);
    };

    /** Search every module by year, semester, specialization and category; each says whether you can add it. */
    const findQ = $<HTMLInputElement>('[data-find-q]');
    const fYear = $<HTMLSelectElement>('[data-find-year]'), fSem = $<HTMLSelectElement>('[data-find-sem]');
    const fSpec = $<HTMLSelectElement>('[data-find-spec]'), fCat = $<HTMLSelectElement>('[data-find-cat]');
    const renderFind = (p: Profile) => {
      const q = findQ.value.trim().toLowerCase();
      const list = data.cards.filter((m) => (!q || `${m.title} ${m.code} ${m.description} ${m.term} ${m.category}`.toLowerCase().includes(q))
        && (!fYear.value || has(m.years, fYear.value))
        && (!fSem.value || inSemester(m, fSem.value as Semester))
        && (!fSpec.value || has(m.specializations, fSpec.value))
        && (!fCat.value || m.category === fCat.value));
      // grouped by year (a module appears under each of its years; open to all years → "All years")
      const groups = [...data.years, 'All years'].map((y) => ({ y, items: list.filter((m) => (y === 'All years' ? !m.years.length : m.years.includes(y))) })).filter((g) => g.items.length && (!fYear.value || g.y === fYear.value || g.y === 'All years'));
      $('[data-others-grid]').innerHTML = groups.map((g) => `<section class="find-group"><h3 class="find-gh">${esc(g.y)}<small>${g.items.length} module${g.items.length === 1 ? '' : 's'}</small></h3>
        <div class="mine-grid small">${g.items.map((m, i) => card(m, i).replace('</h3>', `</h3><span class="find-chips"><span>${esc(m.category)}</span><span>${m.semester === 'Both' ? 'Both semesters' : esc(m.semester)}</span>${m.specializations.length ? m.specializations.map((s) => `<span>${esc(s)}</span>`).join('') : '<span>All specializations</span>'}</span>${forMe(m, p)
            ? '<span class="mstate mine">✓ Already in your modules</span>' : selfEnrol(m, p)
            ? `<button type="button" class="mstate add" data-add="${esc(m.slug)}">+ Add as my module</button>`
            : '<span class="mstate locked">Invitation only · ask the module leader</span>'}`)).join('')}</div></section>`).join('');
      $('[data-find-none]').hidden = groups.length > 0;
    };
    [findQ, fYear, fSem, fSpec, fCat].forEach((el) => el.addEventListener('input', () => profile && renderFind(profile)));
    $('[data-others-grid]').addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-add]');
      if (!b || !profile) return;
      e.preventDefault();
      const next = { ...profile, modules: [...new Set([...profile.modules, b.dataset.add!])] };
      if (student) {
        const r = await fetch('/api/auth/me', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(next) });
        if (!r.ok) return;
      }
      local.set(next);
      profile = next;
      showMine(profile);
    });

    // onboarding
    const draft: Profile = { year: profile?.year ?? '', specialization: profile?.specialization ?? '', modules: [...(profile?.modules ?? [])] };
    let step = 1;
    const next = $<HTMLButtonElement>('[data-ob-next]'), back = $<HTMLButtonElement>('[data-ob-back]'), msg = $('[data-ob-msg]');
    const pills = (key: 'year' | 'specialization', items: string[]) => {
      const box = $(`[data-pills="${key}"]`);
      box.innerHTML = items.map((v) => `<button type="button" class="ob-pill" aria-pressed="${draft[key] === v}" data-v="${esc(v)}">${esc(v)}</button>`).join('');
      box.onclick = (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-v]');
        if (!b) return;
        if (key === 'specialization' && !specialized(draft.year)) return;
        draft[key] = b.dataset.v!;
        box.querySelectorAll('[data-v]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render();
        // pick → next; before the specialization starts (Year 3 · Semester 2) there is nothing to pick
        if (key === 'year') draft.specialization = specialized(draft.year) ? (draft.specialization === GENERAL ? '' : draft.specialization) : GENERAL;
        setTimeout(() => go(1), 180);
      };
    };
    const opts = () => {
      const list = optionalFor(data.cards, draft);
      draft.modules = draft.modules.filter((m) => list.some((c) => c.slug === m));
      $('[data-opts]').innerHTML = list.length
        ? list.map((m) => `<button type="button" class="ob-opt" style="--c:${esc(m.color)}" aria-pressed="${draft.modules.includes(m.slug)}" data-m="${esc(m.slug)}"><b>${esc(m.title)}</b><small>${esc(m.code || 'Optional')}${m.term ? ` · ${esc(m.term)}` : ''}</small></button>`).join('')
        : '<p class="ob-empty">There are no optional modules for your year and specialization yet. Press Finish.</p>';
      $('[data-opts]').onclick = (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-m]');
        if (!b) return;
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        draft.modules = on ? [...draft.modules, b.dataset.m!] : draft.modules.filter((x) => x !== b.dataset.m);
      };
    };
    const render = () => {
      root.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
      root.querySelectorAll<HTMLElement>('[data-step-dot]').forEach((d) => {
        const n = Number(d.dataset.stepDot);
        d.classList.toggle('on', n === step);
        d.classList.toggle('done', n < step);
      });
      back.hidden = step === 1;
      next.textContent = step === 3 ? 'Finish ✓' : 'Next →';
      next.disabled = (step === 1 && !draft.year) || (step === 2 && !draft.specialization);
      const hasSpecialization = specialized(draft.year);
      $('[data-pills="specialization"]').hidden = !hasSpecialization;
      const general = $('[data-spec-general]');
      general.hidden = hasSpecialization;
      general.textContent = draft.year ? `General — specialization starts in ${data.specFrom.year}, ${data.specFrom.semester}.` : 'Choose your year first.';
      if (step === 3) opts();
      msg.textContent = '';
    };
    const go = (d: number) => {
      step = Math.max(1, Math.min(3, step + d));
      render();
    };
    next.addEventListener('click', async () => {
      if (step < 3) return go(1);
      next.disabled = true;
      if (student) {
        const r = await fetch('/api/auth/me', { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(draft) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { msg.textContent = d.error ?? 'Could not save.'; next.disabled = false; return; }
      }
      local.set(draft);
      profile = { ...draft };
      showMine(profile);
    });
    back.addEventListener('click', () => go(-1));
    $('[data-edit]').addEventListener('click', () => { mine.hidden = true; ob.hidden = false; step = 1; $('[data-hub-title]').innerHTML = 'Choose your <span>module</span>'; render(); });
    pills('year', data.years);
    pills('specialization', data.specializations);
    render();

    if (profile && [...fYear.options].some((o) => o.value === profile!.year)) fYear.value = profile.year;
    if (profile) showMine(profile);
    else ob.hidden = false;
  }
  const initPage = () => void init();
  document.addEventListener('astro:page-load', initPage);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initPage, { once: true });
  else initPage();
</script>
