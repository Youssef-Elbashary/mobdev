---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/home/Hero.astro';
import Roadmap from '@/components/home/Roadmap.astro';
import Icon from '@/components/Icon.astro';
import CmdLine from '@/components/CmdLine.astro';
import EmptyState from '@/components/EmptyState.astro';
import ToolLogo from '@/components/ToolLogo.astro';
import SplitBar from '@/components/SplitBar.astro';
import { course, team, assessment } from '@/site.config';
import { getLabs, getCoursework, getTools, getSetup, getProject, groupBy, pad, formatDeadline, getData } from '@/lib/content';

const [labs, coursework, tools, setup, project, commands, resources, extra, checklist, troubles] = await Promise.all([
  getLabs(), getCoursework(), getTools(), getSetup(), getProject(),
  getData('commands'), getData('resources'), getData('extra'), getData('checklist'), getData('troubleshooting'),
]);
const counts = { labs: labs.length, coursework: coursework.length, commands: commands.length, tools: tools.length };

const workspace = [
  { path: 'labs/', label: 'Labs', desc: 'Step-by-step practical sessions', href: '/labs', n: labs.length, icon: 'flask' },
  { path: 'coursework/', label: 'Coursework', desc: 'Graded assignments & deadlines', href: '/coursework', n: coursework.length, icon: 'file' },
  { path: 'project/', label: 'Course Project', desc: 'The capstone app you ship', href: '/project', n: project ? 1 : 0, icon: 'rocket' },
  { path: 'commands/', label: 'Command Handbook', desc: 'Searchable, copyable commands', href: '/commands', n: commands.length, icon: 'terminal' },
  { path: 'tools/', label: 'Development Tools', desc: 'Everything you install & why', href: '/tools', n: tools.length, icon: 'wrench' },
  { path: 'setup/', label: 'Setup & Installation', desc: 'From zero to a working machine', href: '/setup', n: setup.length, icon: 'download' },
  { path: 'troubleshooting/', label: 'Troubleshooting', desc: 'Errors, causes and fixes', href: '/troubleshooting', n: troubles.length, icon: 'bug' },
  { path: 'resources/', label: 'Resources', desc: 'Docs, tutorials & cheat sheets', href: '/resources', n: resources.length, icon: 'book' },
] as const;

const cmdGroups = [...groupBy(commands, (c) => c.data.category)].slice(0, 5);
const resGroups = [...groupBy(resources, (r) => r.data.category)];
---
<Base>
  <Hero counts={counts} />

  <!-- WORKSPACE ------------------------------------------------------------>
  <section class="section ws" id="workspace" aria-labelledby="ws-title">
    <div class="container ws-grid">
      <div class="ws-head">
        <p class="eyebrow" data-reveal>Where is everything?</p>
        <h2 id="ws-title" class="h-2 mt-4" data-reveal>Your Mobile Development workspace.</h2>
        <p class="lead mt-6" data-reveal>Every lab, deadline, command, installer and fix for this course lives here. Bookmark this page — it's the only one you need.</p>
        <button class="btn btn-ghost mt-8" data-search-open data-reveal>
          <Icon name="search" /> Search everything <span class="kbd" data-mod-key>Ctrl</span><span class="kbd" style="margin-left:-6px">K</span>
        </button>
      </div>
      <div class="ws-tree" data-reveal>
        <div class="ws-tree-head mono"><span><span class="accent">~/</span>mobile-development</span><span class="faint">{workspace.length} dirs</span></div>
        <ul>
          {workspace.map((w, i) => (
            <li>
              <a href={w.href} class="ws-row" style={`--d:${i * 40}ms`}>
                <span class="ws-ic"><Icon name={w.icon} /></span>
                <span class="ws-txt">
                  <span class="ws-path mono">{w.path}</span>
                  <span class="ws-label">{w.label}<span class="ws-desc"> — {w.desc}</span></span>
                </span>
                <span class="ws-n mono">{pad(w.n)}</span>
                <Icon name="arrow" class="ws-go" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- OVERVIEW ------------------------------------------------------------->
  <section class="section section-alt ov" id="overview" aria-labelledby="ov-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Course overview</p>
          <h2 id="ov-title" class="h-2 mt-4" data-reveal>Build real apps.<br /><span class="faint">Understand every layer.</span></h2>
        </div>
        <p class="lead" data-reveal>{course.overview.what}</p>
      </div>

      <dl class="ov-stats" data-reveal>
        <div><dt>Labs</dt><dd class="num">{pad(labs.length)}</dd></div>
        <div><dt>Coursework</dt><dd class="num">{pad(coursework.length)}</dd></div>
        <div><dt>Course project</dt><dd class="num">{pad(project ? 1 : 0)}</dd></div>
        <div><dt>Tools</dt><dd class="num">{pad(tools.length)}</dd></div>
        <div><dt>Commands</dt><dd class="num">{pad(commands.length)}</dd></div>
      </dl>

      <div class="ov-spec">
        <div class="ov-row" data-reveal>
          <h3 class="mono ov-k">01 — You'll learn</h3>
          <ul class="dash-list">{course.overview.learn.map((l) => <li>{l}</li>)}</ul>
        </div>
        <div class="ov-row" data-reveal>
          <h3 class="mono ov-k">02 — You'll build</h3>
          <p>{course.overview.build}</p>
        </div>
        <div class="ov-row" data-reveal>
          <h3 class="mono ov-k">03 — You'll use</h3>
          <p>{course.overview.tools} <a href="/tools" class="inline-link">See the toolkit →</a></p>
        </div>
        <div class="ov-row" data-reveal>
          <h3 class="mono ov-k">04 — Assessment</h3>
          <div class="asm">
            <SplitBar items={assessment.map((a) => ({ label: a.label, value: a.weight, sub: a.sub }))} size="md" />
            <a href="/coursework" class="inline-link">Coursework breakdown →</a>
          </div>
        </div>
        <div class="ov-row" data-reveal id="team">
          <h3 class="mono ov-k">05 — Teaching team</h3>
          <ul class="team">
            {team.map((m) => (
              <li>
                <span class="av mono" aria-hidden="true">{m.name.replace(/^Dr\.\s*/, '').split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
                <span class="tm"><span class="tm-n">{m.name}</span><span class="tm-r mono">{m.role}</span></span>
                <a href={`mailto:${m.email}`} class="tm-e mono">{m.email}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="ov-row ov-outcome" data-reveal>
          <h3 class="mono ov-k">06 — By the end</h3>
          <p class="ov-big">{course.overview.outcome}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROADMAP -------------------------------------------------------------->
  <Roadmap />

  <!-- LABS ----------------------------------------------------------------->
  <section class="section section-alt" id="labs" aria-labelledby="labs-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Labs</p>
          <h2 id="labs-title" class="h-2 mt-4" data-reveal>Learn by building.</h2>
        </div>
        <div class="flex between items-center wrap gap-4" data-reveal>
          <p class="muted" style="max-width:40ch">Guided, hands-on sessions. Each lab has objectives, steps, testing, troubleshooting and a submission checklist.</p>
          <a href="/labs" class="btn btn-ghost btn-sm">All labs <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      {labs.length === 0 ? (
        <EmptyState title="Labs are coming soon." body="The first lab will appear here as soon as it's published." path="labs/" />
      ) : (
        <div class="row-list lab-rows">
          {labs.slice(0, 6).map((l, i) => (
            <a href={`/labs/${l.id}`} class="row lab-row" data-reveal style={`--d:${i * 50}ms`}>
              <span class="lab-no mono">LAB<b>{pad(l.data.number)}</b></span>
              <span class="lab-main">
                <span class="lab-t">{l.data.title}</span>
                <span class="lab-d">{l.data.description}</span>
              </span>
              <span class="lab-meta">
                <span class={`badge badge-${l.data.difficulty.toLowerCase()}`}><span class="dot"></span>{l.data.difficulty}</span>
                <span class="mono faint lab-time"><Icon name="clock" size={14} />{l.data.estimatedTime}</span>
              </span>
              <span class="go"><Icon name="arrow-up-right" /></span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- COURSEWORK ----------------------------------------------------------->
  <section class="section" id="coursework" aria-labelledby="cw-title">
    <div class="container cw-grid">
      <div>
        <p class="eyebrow" data-reveal>Coursework</p>
        <h2 id="cw-title" class="h-2 mt-4" data-reveal>Assessed work,<br />clearly explained.</h2>
        <p class="muted mt-6" data-reveal style="max-width:38ch">Objectives, tasks, deliverables, grading and deadlines — one readable page per assignment.</p>
        <a href="/coursework" class="btn btn-ghost btn-sm mt-8" data-reveal>View coursework <Icon name="arrow" class="arrow" /></a>
      </div>
      <div class="cw-list">
        {coursework.length === 0 ? (
          <EmptyState title="No coursework published yet." body="Assignments will appear here with their deadlines." path="coursework/" />
        ) : coursework.map((c, i) => (
          <a href={`/coursework/${c.id}`} class="cw-item" data-reveal style={`--d:${i * 80}ms`}>
            <div class="cw-top mono"><span>CW{pad(c.data.number)}</span><span class="cw-due"><Icon name="calendar" size={14} /> Due {formatDeadline(c.data.deadline)}</span></div>
            <h3 class="h-3">{c.data.title}</h3>
            <p class="muted">{c.data.description}</p>
            <div class="cw-foot">
              <span class="mono faint">{c.data.tasks.length} tasks · {c.data.deliverables.length} deliverables</span>
              <span class="go"><Icon name="arrow-up-right" /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECT -------------------------------------------------------------->
  {project && (
    <section class="pj" id="project" aria-labelledby="pj-title">
      <div class="container">
        <div class="pj-card" data-reveal>
          <div class="pj-grid-bg grid-bg" aria-hidden="true"></div>
          <div class="pj-top">
            <span class="badge badge-accent"><span class="dot"></span>Capstone</span>
            <span class="mono faint">Due {formatDeadline(project.data.deadline)}</span>
          </div>
          <h2 id="pj-title" class="pj-title">{project.data.tagline}</h2>
          <p class="pj-lead">{project.data.description}</p>
          <ol class="pj-track" aria-label="Project milestones">
            {project.data.milestones.map((m, i) => (
              <li style={`--i:${i}`}>
                <span class="pj-dot"></span>
                <span class="mono pj-mi">M{i + 1}</span>
                <span class="pj-mn">{m.name}</span>
                {m.due && <span class="mono pj-md">{m.due}</span>}
              </li>
            ))}
          </ol>
          <div class="pj-cta">
            <a href="/project" class="btn btn-primary">Open the project brief <Icon name="arrow" class="arrow" /></a>
            <span class="mono faint pj-feat">{project.data.features.filter((f) => f.required).length} required features · {project.data.deliverables.length} deliverables</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- COMMANDS ------------------------------------------------------------->
  <section class="section" id="commands" aria-labelledby="cmd-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Command handbook</p>
          <h2 id="cmd-title" class="h-2 mt-4" data-reveal>Stop Googling<br />the same commands.</h2>
        </div>
        <div class="flex between items-center wrap gap-4" data-reveal>
          <p class="muted" style="max-width:40ch">{commands.length} commands across Git, terminal, packages, Android, builds and debugging — searchable and one-click copyable.</p>
          <a href="/commands" class="btn btn-ghost btn-sm">Open handbook <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <div class="term-demo" data-reveal data-tabs>
        <div class="td-head">
          <span class="dots"><i></i><i></i><i></i></span>
          <div class="td-tabs" role="tablist" aria-label="Command categories">
            {cmdGroups.map(([cat], i) => (
              <button role="tab" id={`td-tab-${i}`} aria-controls={`td-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="td-tab mono">{cat}</button>
            ))}
          </div>
        </div>
        {cmdGroups.map(([cat, items], i) => (
          <div class="td-panel" role="tabpanel" id={`td-panel-${i}`} aria-labelledby={`td-tab-${i}`} hidden={i !== 0}>
            {items.slice(0, 5).map((c) => (
              <div class="td-row">
                <CmdLine cmd={c.data.command} />
                <p class="td-desc"><strong>{c.data.title}.</strong> {c.data.description}</p>
              </div>
            ))}
            <a href={`/commands?c=${encodeURIComponent(cat)}`} class="td-more mono">→ all {cat} commands</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLKIT -------------------------------------------------------------->
  <section class="section section-alt" id="tools" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Development toolkit</p>
          <h2 id="tools-title" class="h-2 mt-4" data-reveal>The tools of the trade.</h2>
        </div>
        <p class="muted" data-reveal>What each tool is, why we use it, how to install it, and what to do when it breaks.</p>
      </div>
      <div class="tk">
        {tools.map((t, i) => (
          <a href={`/tools/${t.id}`} class="tk-item" data-reveal style={`--d:${i * 50}ms; --c:${t.data.color ?? 'var(--accent)'}`}>
            <ToolLogo logo={t.data.logo} monogram={t.data.monogram} name={t.data.name} color={t.data.color} size={52} class="tk-logo" />
            <span class="tk-cat mono">{t.data.category}</span>
            <span class="tk-name">{t.data.name}</span>
            <span class="tk-desc">{t.data.description}</span>
            <span class="tk-plat mono">{t.data.platforms.join(' · ')}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SETUP ---------------------------------------------------------------->
  <section class="section" id="setup" aria-labelledby="setup-title">
    <div class="container su-grid">
      <div>
        <p class="eyebrow" data-reveal>Setup & installation</p>
        <h2 id="setup-title" class="h-2 mt-4" data-reveal>From “I just started”<br />to “my machine is ready.”</h2>
        <p class="muted mt-6" data-reveal style="max-width:42ch">{setup.length} guided steps for Windows, macOS and Linux — each with verification commands and fixes for common errors.</p>
        <div class="su-progress panel" data-reveal data-setup-mini data-total={checklist.length}>
          <div class="flex between items-center">
            <span class="mono faint" style="font-size:12px">Your setup progress</span>
            <span class="mono" data-mini-label>0 / {checklist.length}</span>
          </div>
          <div class="su-bar"><i data-mini-bar></i></div>
          <a href="/setup#checklist" class="btn btn-primary btn-sm mt-4">Open checklist <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <ol class="su-steps">
        {setup.map((s, i) => (
          <li data-reveal style={`--d:${i * 50}ms`}>
            <a href={`/setup/${s.id}`} class="su-step">
              <span class="su-n mono">{pad(s.data.step)}</span>
              <span class="su-t">{s.data.title}</span>
              {s.data.estimatedTime && <span class="su-time mono">{s.data.estimatedTime}</span>}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- RESOURCES ------------------------------------------------------------>
  <section class="section section-alt" id="resources" aria-labelledby="res-title">
    <div class="container">
      <div class="section-head split">
        <div>
          <p class="eyebrow" data-reveal>Resources</p>
          <h2 id="res-title" class="h-2 mt-4" data-reveal>Curated, not collected.</h2>
        </div>
        <div class="flex between items-center wrap gap-4" data-reveal>
          <p class="muted" style="max-width:40ch">Official docs, tutorials and references chosen for this course.</p>
          <a href="/resources" class="btn btn-ghost btn-sm">All resources <Icon name="arrow" class="arrow" /></a>
        </div>
      </div>
      <div class="res-cols">
        {resGroups.slice(0, 4).map(([cat, items], i) => (
          <div class="res-col" data-reveal style={`--d:${i * 60}ms`}>
            <h3 class="mono res-cat">{cat}</h3>
            <ul>
              {items.slice(0, 4).map((r) => (
                <li><a href={r.data.href} target={r.data.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{r.data.title}<Icon name="arrow-up-right" size={14} /></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EXTRA ---------------------------------------------------------------->
  <section class="section ex" id="extra" aria-labelledby="ex-title">
    <div class="container">
      <div class="ex-box" data-reveal>
        <div class="ex-head">
          <span class="badge badge-optional"><span class="dot"></span>Optional</span>
          <h2 id="ex-title" class="h-3">Extra learning</h2>
          <p class="muted">Not required for grades. For students who want to go further.</p>
        </div>
        <ul class="ex-tags">
          {extra.map((e) => <li><a href={`/extra#${e.id}`}>{e.data.category}</a></li>)}
        </ul>
        <a href="/extra" class="btn btn-ghost btn-sm">Explore <Icon name="arrow" class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA ------------------------------------------------------------>
  <section class="final">
    <div class="container final-inner">
      <p class="eyebrow no-slash mono" data-reveal>$ where is everything?</p>
      <h2 class="h-1 final-t" data-reveal>Right <span class="accent">here.</span></h2>
      <div class="flex wrap gap-3 mt-8" data-reveal style="justify-content:center">
        <a href="/labs/lab-01" class="btn btn-primary btn-lg">Start with Lab 01 <Icon name="arrow" class="arrow" /></a>
        <a href="/setup" class="btn btn-ghost btn-lg">Set up my computer</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* workspace */
  .ws-grid { display: grid; gap: 48px; }
  @media (min-width: 960px) { .ws-grid { grid-template-columns: 0.9fr 1.1fr; gap: 80px; align-items: start; } .ws-head { position: sticky; top: calc(var(--nav-h) + 48px); } }
  .ws-head .kbd { margin-left: 4px; }
  .ws-tree { border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); overflow: hidden; }
  .ws-tree-head { display: flex; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--line); font-size: 12.5px; background: var(--surface-2); }
  .ws-tree ul { list-style: none; padding: 6px; }
  .ws-row { display: grid; grid-template-columns: 40px 1fr auto 20px; align-items: center; gap: 16px; padding: 14px; border-radius: var(--r-md); transition: background var(--t-fast); }
  .ws-row:hover { background: var(--surface-2); }
  .ws-ic { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; border: 1px solid var(--line-2); color: var(--text-2); transition: all var(--t-med) var(--ease-out); }
  .ws-ic :global(svg) { width: 18px; height: 18px; }
  .ws-row:hover .ws-ic { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); transform: rotate(-6deg); }
  .ws-txt { display: grid; min-width: 0; }
  .ws-path { font-size: 11.5px; color: var(--accent-text); }
  .ws-label { font-weight: 550; color: var(--text); }
  .ws-desc { font-weight: 400; color: var(--text-3); }
  .ws-n { font-size: 12px; color: var(--text-3); }
  .ws-row :global(.ws-go) { width: 16px; height: 16px; color: var(--text-3); transition: transform var(--t-med) var(--ease-out); }
  .ws-row:hover :global(.ws-go) { transform: translateX(3px); color: var(--text); }
  @media (max-width: 560px) { .ws-desc { display: none; } .ws-row { gap: 12px; } }

  /* overview */
  .ov-stats { display: grid; grid-template-columns: repeat(2, 1fr); border-block: 1px solid var(--line); margin-bottom: 64px; }
  @media (min-width: 720px) { .ov-stats { grid-template-columns: repeat(5, 1fr); } }
  .ov-stats > div { padding: 24px 20px 24px 0; border-right: 1px solid var(--line); }
  .ov-stats > div + div { padding-left: 20px; }
  .ov-stats > div:last-child { border-right: 0; }
  @media (max-width: 719px) { .ov-stats > div:nth-child(2n) { border-right: 0; } .ov-stats > div:nth-child(2n+1) { padding-left: 0; } .ov-stats > div { border-bottom: 1px solid var(--line); } }
  .ov-stats dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .ov-stats dd { font-family: var(--font-display); font-size: clamp(40px, 5vw, 64px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; margin-top: 12px; }
  .ov-spec { display: grid; gap: 0; }
  .ov-row { display: grid; gap: 12px; padding-block: 28px; border-top: 1px solid var(--line); color: var(--text-2); }
  @media (min-width: 900px) { .ov-row { grid-template-columns: 280px 1fr; gap: 48px; } }
  .ov-k { font-size: 12px; font-weight: 500; letter-spacing: 0.04em; color: var(--text-3); text-transform: uppercase; padding-top: 4px; font-family: var(--font-mono); }
  .ov-big { font-family: var(--font-display); font-size: var(--fs-xl); line-height: 1.2; letter-spacing: -0.02em; color: var(--text); font-weight: 550; max-width: 30ch; }
  .inline-link { color: var(--accent-text); white-space: nowrap; }
  .asm { display: grid; gap: 18px; max-width: 640px; }
  .team { list-style: none; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .team li { display: grid; grid-template-columns: 40px 1fr; align-items: center; gap: 4px 14px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 720px) { .team li { grid-template-columns: 40px 1fr auto; } }
  .av { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; background: var(--surface-2); border: 1px solid var(--line-2); color: var(--text); grid-row: span 2; }
  @media (min-width: 720px) { .av { grid-row: auto; } }
  .team li:first-child .av { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .tm { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .tm-n { font-weight: 550; color: var(--text); }
  .tm-r { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); }
