---
/**
 * /admin — password-protected live attendance list.
 * Shows (1) what's missing if the database or password isn't set up yet,
 * (2) the login form, or (3) the live table.
 */
import Base from '@/layouts/Base.astro';
import { isAdmin, setupStatus } from '@/lib/attendance/server';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');

const status = setupStatus();
const ready = status.database && status.password;
const admin = ready && isAdmin(Astro.cookies);
const error = Astro.url.searchParams.get('e');

---
<Base title="Attendance admin" noindex>
  <section class="adm container">
    {!ready ? (
      <div class="adm-card setup">
        <p class="adm-k mono">Attendance · setup</p>
        <h1 class="adm-h">Almost ready</h1>
        <p class="muted">Two settings are needed in your Vercel project before attendance can run:</p>
        <ol class="setup-list">
          <li class:list={[{ ok: status.database }]}>
            <span class="st" aria-hidden="true">{status.database ? '✓' : '1'}</span>
            <div>
              <b>Database {status.database ? 'connected' : 'not connected'}</b>
              {!status.database && <p>In Supabase, run <code>supabase/attendance.sql</code> in the <b>SQL Editor</b>. Then in Vercel → <b>Settings</b> → <b>Environment Variables</b> add <code>SUPABASE_URL</code> and <code>SUPABASE_SECRET_KEY</code>.</p>}
            </div>
          </li>
          <li class:list={[{ ok: status.password }]}>
            <span class="st" aria-hidden="true">{status.password ? '✓' : '2'}</span>
            <div>
              <b>Admin password {status.password ? 'set' : 'not set'}</b>
              {!status.password && <p>Vercel → project → <b>Settings</b> → <b>Environment Variables</b> → add <code>ADMIN_PASSWORD</code> with the password you want → <b>Save</b>.</p>}
            </div>
          </li>
        </ol>
        <p class="faint small">Then redeploy the project so the new settings take effect. This page turns into the login screen by itself.</p>
      </div>
    ) : !admin ? (
      <form class="adm-card login" method="post" action="/api/admin/login">
        <p class="adm-k mono">Attendance · admin</p>
        <h1 class="adm-h">Log in</h1>
        <label class="fld">
          <span class="fld-l">Password</span>
          <input class="input fld-i" type="password" name="password" autocomplete="current-password" required autofocus />
        </label>
        {error === 'wrong' && <p class="form-e" role="alert">Wrong password. Try again.</p>}
        {error === 'wait' && <p class="form-e" role="alert">Too many tries. Wait 10 minutes and try again.</p>}
        <button class="btn btn-primary btn-lg" type="submit">Log in</button>
      </form>
    ) : (
      <>
      <div class="adm-tabs" role="tablist" aria-label="Admin sections">
        <button role="tab" type="button" aria-selected="true" data-tab="att">Attendance</button>
        <button role="tab" type="button" aria-selected="false" data-tab="lab">Lab progress</button>
        <button role="tab" type="button" aria-selected="false" data-tab="sessions">Sessions</button>
        <label class="tab-filter"><span>Lab</span><select class="input" data-admin-lab aria-label="Select lab"></select></label>
        <label class="tab-filter"><span>Attendance session</span><select class="input" data-admin-session aria-label="Select attendance session"></select></label>
      </div>
      <div data-panel="sessions" hidden>
        <section class="session-admin">
          <header class="session-head">
            <div>
              <p class="adm-k mono">Lab sessions</p>
              <h1 class="adm-h">Manage teaching sessions</h1>
              <p class="muted">Create a time slot first, then start it when students may begin the lab.</p>
            </div>
          </header>
          <form class="session-create" data-session-create>
            <label><span>TA name</span><input class="input" name="taName" required maxlength="60" placeholder="Teaching assistant name" /></label>
            <label><span>Time slot</span><input class="input" name="timeSlot" required maxlength="80" placeholder="e.g. Monday 10:00–12:00" /></label>
            <label><span>Duration</span><select class="input" name="minutes"><option value="60">60 min</option><option value="90" selected>90 min</option><option value="120">120 min</option><option value="180">180 min</option><option value="">No limit</option></select></label>
            <button class="btn btn-primary" type="submit">Create session</button>
          </form>
          <p class="session-message small" data-session-message role="status"></p>
          <div class="session-list" data-session-list></div>
        </section>
      </div>
      <div data-panel="lab" hidden>
        <div class="labp" data-labp data-lab="">
          <header class="board-head">
            <div>
              <p class="adm-k mono" data-lab-title>Lab progress</p>
              <h1 class="board-count"><b data-lp-started>–</b> <span>students started</span></h1>
            </div>
            <div class="board-actions">
              <span class="live mono" data-lp-live>loading…</span>
              <a class="btn btn-ghost btn-sm" data-open-lab href="/labs" target="_blank" rel="noopener">Open lab ↗</a>
            </div>
          </header>
          <div class="kpis" data-lp-kpis></div>
          <section class="lp-sec">
            <h2 class="lp-h">Hardest right now</h2>
            <div class="hard" data-lp-hardest><p class="faint small">Nobody has checked an exercise yet.</p></div>
          </section>
          <section class="lp-sec">
            <h2 class="lp-h">Exercises</h2>
            <div class="table-wrap"><table class="table ex-table"><thead><tr><th>#</th><th>Exercise</th><th>Solved</th><th>Average tries</th><th>Median solve</th></tr></thead><tbody data-lp-ex></tbody></table></div>
          </section>
          <section class="lp-sec">
            <h2 class="lp-h">Students</h2>
            <div class="table-wrap"><table class="table st-table"><thead data-lp-st-head></thead><tbody data-lp-st></tbody></table></div>
            <p class="empty-row" data-lp-empty>No students yet — they appear here when they press <b>Start</b> on the lab page.</p>
          </section>
        </div>
      </div>
      <div data-panel="att">
      <div class="board" data-lab-attendance>
        <header class="board-head">
          <div>
            <p class="adm-k mono"><span data-att-lab>Selected lab</span> · attendance</p>
            <h1 class="board-count"><b data-att-count>–</b> <span data-att-summary>students identified</span></h1>
          </div>
            <div class="board-actions">
              <span class="live mono" data-att-live>loading…</span>
              <button class="btn btn-primary btn-sm" type="button" data-open-sessions>Manage selected session</button>
              <a class="btn btn-ghost btn-sm" data-session-insights href="/admin/progress">Session insights →</a>
            <a class="btn btn-ghost btn-sm" href="/admin/cms">CMS →</a>
            <form method="post" action="/api/admin/logout"><button class="btn btn-ghost btn-sm" type="submit">Log out</button></form>
          </div>
        </header>
        <p class="muted small">This attendance list belongs only to the teaching session selected above. Students, check-ins and progress from parallel sessions remain separate.</p>
        <div class="table-wrap board-table">
          <table class="table">
            <thead><tr><th scope="col">Name</th><th scope="col">Student ID</th><th scope="col">Group</th><th scope="col">Started</th><th scope="col">Last seen</th><th scope="col">Progress</th><th scope="col">Attendance</th></tr></thead>
            <tbody data-att-rows></tbody>
          </table>
          <p class="empty-row" data-att-empty>No students have started this session yet.</p>
        </div>
      </div>
      </div>
      </>
    )}
  </section>
</Base>

<style>
  .adm { padding-top: calc(var(--nav-h) + 56px); padding-bottom: 96px; min-height: 80dvh; }
  .adm-card { width: min(100%, 520px); margin-inline: auto; display: grid; gap: 16px; padding: clamp(24px, 5vw, 36px); border-radius: var(--r-xl); border: 1px solid var(--line-2); background: var(--surface); box-shadow: var(--shadow-md); }
  .adm-k { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-text); }
  .adm-h { font-size: var(--fs-2xl); letter-spacing: -0.04em; }
  .fld { display: grid; gap: 8px; }
  .fld-l { font-size: 13px; font-weight: 600; }
  .fld-i { padding-left: 16px; height: 52px; font-size: 16px; border-radius: 14px; }
  .form-e { font-size: 13.5px; color: var(--danger); padding: 10px 12px; border-radius: 10px; background: var(--danger-soft); border: 1px solid color-mix(in oklab, var(--danger) 40%, transparent); }
  .small { font-size: 13px; }

  .setup-list { list-style: none; padding: 0; display: grid; gap: 10px; }
  .setup-list li { display: grid; grid-template-columns: 32px 1fr; gap: 12px; padding: 14px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--bg); }
  .setup-list li p { margin-top: 6px; font-size: 14px; color: var(--text-2); }
  .setup-list .st { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font: 700 13px var(--font-mono); background: var(--warn-soft); color: var(--warn); border: 1px solid color-mix(in oklab, var(--warn) 45%, transparent); }
  .setup-list li.ok .st { background: var(--ok); color: #fff; border-color: var(--ok); }

  .board { display: grid; gap: 20px; }
  .board-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; }
  .board-count { font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem); letter-spacing: -0.04em; margin-top: 6px; }
  .board-count b { color: var(--accent-text); font-variant-numeric: tabular-nums; }
  .board-count span { font-size: 0.45em; color: var(--text-2); font-weight: 500; letter-spacing: -0.01em; }
  .board-actions { display: flex; align-items: center; gap: 10px; }
  .live { display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-2); font-size: 12px; color: var(--text-3); }
  .live::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--warn); }
  .live.on { color: var(--ok); border-color: color-mix(in oklab, var(--ok) 45%, transparent); }
  .live.on::before { background: var(--ok); animation: pulse-ring 2s infinite; }
  .board-table .table { min-width: 0; }
  /* :global — rows added live by the script don't carry this page's scoped attribute */
  .board-table :global(td), .board-table :global(th) { white-space: nowrap; }
  .board-table :global(td:first-child) { white-space: normal; font-weight: 550; }
  .board-table :global(.att-state) { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 650; color: var(--text-3); }
  .board-table :global(.att-state.active) { color: var(--ok); }
  .board-table :global(.att-state.checked) { color: var(--accent-text); }
  :global(tr.fresh) { animation: row-in 2.2s var(--ease-out); }
  @keyframes row-in { 0% { background: var(--accent-soft); transform: translateY(-6px); opacity: 0; } 15% { opacity: 1; transform: none; } 100% { background: transparent; } }
  .empty-row { padding: 28px 16px; text-align: center; color: var(--text-3); font-size: 14px; }
  @media (max-width: 700px) { .board-table :global(th:nth-child(3)), .board-table :global(td:nth-child(3)) { display: none; } }

  /* tabs */
  .adm-tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; margin-bottom: 28px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); }
  .adm-tabs button { padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px; color: var(--text-3); }
  .adm-tabs button[aria-selected='true'] { background: var(--accent); color: var(--accent-ink); }
  .adm-tabs select { height: 34px; padding: 0 10px; border-radius: 10px; max-width: min(280px, 40vw); }
  .tab-filter { display: flex; align-items: center; gap: 7px; padding-left: 8px; font-size: 11px; font-weight: 700; color: var(--text-3); }
  .tab-filter span { white-space: nowrap; }

  /* session CRUD */
  .session-admin { display: grid; gap: 22px; }
  .session-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; }
  .session-head .muted { margin-top: 8px; }
  .session-create { display: grid; grid-template-columns: minmax(180px, 0.8fr) minmax(240px, 1.2fr) 120px auto; align-items: end; gap: 12px; padding: 18px; border: 1px solid var(--line-2); border-radius: var(--r-lg); background: var(--surface); }
  .session-create label, .session-list :global(label) { display: grid; gap: 6px; min-width: 0; font-size: 12px; font-weight: 650; color: var(--text-2); }
  .session-create .input, .session-list :global(.input) { height: 40px; padding: 0 12px; border-radius: 10px; }
  .session-message { min-height: 1.25em; color: var(--text-3); }
  .session-message.err { color: var(--danger); }
  .session-list { display: grid; gap: 12px; }
  .session-list :global(.session-row) { display: grid; grid-template-columns: minmax(150px, 0.8fr) minmax(210px, 1.2fr) 120px; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); }
  .session-list :global(.session-row.live-row) { border-color: color-mix(in oklab, var(--ok) 48%, var(--line)); box-shadow: inset 3px 0 0 var(--ok); }
  .session-list :global(.session-meta) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; font-size: 12px; color: var(--text-3); }
  .session-list :global(.session-state) { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .session-list :global(.session-state)::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--text-3); }
  .session-list :global(.session-state.live)::before { background: var(--ok); }
  .session-list :global(.session-actions) { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
  .session-list :global(.danger) { color: var(--danger); margin-left: auto; }
  .session-list :global(.empty-session) { padding: 32px; text-align: center; border: 1px dashed var(--line-2); border-radius: var(--r-lg); color: var(--text-3); }
  @media (max-width: 760px) {
    .adm-tabs { display: flex; flex-wrap: wrap; }
    .adm-tabs select { max-width: 100%; flex: 1 1 220px; }
    .session-create, .session-list :global(.session-row) { grid-template-columns: 1fr; }
    .session-list :global(.session-meta), .session-list :global(.session-actions) { grid-column: 1; }
    .session-list :global(.danger) { margin-left: 0; }
  }

  /* lab progress panel (rows are built by the script → :global) */
  .labp { display: grid; gap: 28px; }
  .lp-sec { display: grid; gap: 12px; }
  .lp-h { font-size: 1.15rem; letter-spacing: -0.02em; }
  .labp :global(.kpis) { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .labp :global(.kpi) { display: grid; gap: 2px; padding: 16px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface); }
  .labp :global(.kpi b) { font-family: var(--font-display); font-size: 2rem; letter-spacing: -0.04em; color: var(--text); line-height: 1.1; }
  .labp :global(.kpi span) { font-size: 12.5px; color: var(--text-3); }
  .labp :global(.kpi.accent b) { color: var(--accent-text); }
  .labp :global(.hard) { display: flex; flex-wrap: wrap; gap: 8px; }
  .labp :global(.hard-chip) { display: grid; gap: 2px; padding: 10px 14px; border-radius: 12px; border: 1px solid color-mix(in oklab, var(--danger) 40%, var(--line)); background: var(--danger-soft); }
  .labp :global(.hard-chip b) { font-size: 14px; color: var(--text); }
  .labp :global(.hard-chip span) { font-size: 12px; color: var(--text-2); }
  .labp :global(.ex-table td), .labp :global(.st-table td), .labp :global(.ex-table th), .labp :global(.st-table th) { white-space: nowrap; }
  .labp :global(.ex-table tr.is-hard td) { background: var(--danger-soft); }
  .labp :global(.rate) { display: inline-flex; align-items: center; gap: 8px; }
  .labp :global(.rate i) { display: block; width: 90px; height: 8px; border-radius: 8px; background: var(--line); overflow: hidden; position: relative; }
  .labp :global(.rate i::after) { content: ''; position: absolute; inset: 0; width: var(--w); background: var(--ok); border-radius: 8px; }
  .labp :global(.rate.low i::after) { background: var(--danger); }
  .labp :global(.rate.mid i::after) { background: var(--warn); }
  .labp :global(.prog) { display: inline-flex; align-items: center; gap: 8px; }
  .labp :global(.prog i) { display: block; width: 80px; height: 8px; border-radius: 8px; background: var(--line); overflow: hidden; position: relative; }
  .labp :global(.prog i::after) { content: ''; position: absolute; inset: 0; width: var(--w); background: var(--accent); border-radius: 8px; }
  .labp :global(.cell) { display: inline-block; width: 14px; height: 14px; border-radius: 4px; background: var(--line); vertical-align: middle; }
  .labp :global(.cell.trying) { background: var(--warn); }
  .labp :global(.cell.solved) { background: var(--ok); }
  .labp :global(.st-table th.c), .labp :global(.st-table td.c) { padding-left: 2px; padding-right: 2px; text-align: center; font-size: 10.5px; }
  .labp :global(.dot-on) { color: var(--ok); }
</style>

<script>
  /* Dynamic attendance + progress summary. Detailed controls live at /admin/progress. */
  type Session = { id: string; ta_name: string; time_slot: string; opens_at: string; closes_at: string | null; duration_minutes: number | null; open: boolean; closesAt?: string | null };
  type LabStats = {
    labs: { id: string; title: string }[];
    structure: { lab: string; title: string; exercises: { id: string; title: string }[]; tasks: unknown[] };
    totals: { active: number; avgPercent: number; solved: number; checkedIn: number; submitted: number };
    exercises: { id: string; solvedPct: number; avgAttempts: number; medianSolveMs: number | null }[];
    students: { key: string; name: string; id: string; group: string; startedAt: string; percent: number; solved: number; lastSeen: string; attended: string | null; checkedInAt: string | null; cells: Record<string, { passed: number; total: number; attempts: number }> }[];
    session: (Session & { closesAt: string | null }) | { open: false; closesAt: null };
    sessions: Session[];
  };

  let timer: number | undefined;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const pct = (r: number | null) => (r === null ? '–' : `${Math.round(r * 100)}%`);
  const ago = (iso: string) => {
    const s = Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 1000));
    return s < 60 ? 'now' : s < 3600 ? `${Math.round(s / 60)} min ago` : new Date(iso).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  };
  const clock = (iso: string) => new Date(iso).toLocaleString([], { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  function sessionMessage(message: string, error = false) {
    const node = document.querySelector<HTMLElement>('[data-session-message]');
    if (!node) return;
    node.textContent = message;
    node.classList.toggle('err', error);
  }

  async function sessionAction(action: string, values: Record<string, unknown> = {}) {
    const root = document.querySelector<HTMLElement>('[data-labp]');
    const lab = document.querySelector<HTMLSelectElement>('[data-admin-lab]')?.value || root?.dataset.lab || '';
    if (!root || !lab) return false;
    sessionMessage('Saving…');
    try {
      const response = await fetch('/api/admin/progress/session', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ lab, action, ...values }),
      });
      if (response.status === 401) return location.reload();
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.message ?? 'Could not save the session.');
      sessionMessage(action === 'delete' ? 'Session deleted.' : 'Session saved.');
      await load(root);
      return true;
    } catch (error) {
      sessionMessage(error instanceof Error ? error.message : 'Could not save the session.', true);
      return false;
    }
  }

  function renderSessionManager(stats: LabStats) {
    const list = document.querySelector<HTMLElement>('[data-session-list]');
    if (!list) return;
    const signature = stats.structure.lab + JSON.stringify(stats.sessions);
    if (list.dataset.signature === signature) return;
    list.dataset.signature = signature;
    if (!stats.sessions.length) {
      list.innerHTML = '<p class="empty-session">No sessions for this lab yet. Create the first time slot above.</p>';
      return;
    }
    list.innerHTML = stats.sessions.map((session) => `<article class="session-row ${session.open ? 'live-row' : ''}" data-session-id="${esc(session.id)}">
      <div class="session-meta mono">
        <span class="session-state ${session.open ? 'live' : ''}">${session.open ? 'Live' : 'Inactive'}</span>
        <span>Started ${clock(session.opens_at)}</span>
        <span>${session.closes_at ? `Ends/ended ${clock(session.closes_at)}` : 'No time limit'}</span>
      </div>
      <label><span>TA name</span><input class="input" data-session-ta maxlength="60" value="${esc(session.ta_name)}" /></label>
      <label><span>Time slot</span><input class="input" data-session-slot maxlength="80" value="${esc(session.time_slot)}" /></label>
      <label><span>Duration</span><select class="input" data-session-duration><option value="60" ${session.duration_minutes === 60 ? 'selected' : ''}>60 min</option><option value="90" ${session.duration_minutes === 90 ? 'selected' : ''}>90 min</option><option value="120" ${session.duration_minutes === 120 ? 'selected' : ''}>120 min</option><option value="180" ${session.duration_minutes === 180 ? 'selected' : ''}>180 min</option><option value="" ${session.duration_minutes === null ? 'selected' : ''}>No limit</option></select></label>
      <div class="session-actions">
        <button class="btn btn-ghost btn-sm" type="button" data-session-action="update">Save changes</button>
        ${session.open
          ? '<button class="btn btn-ghost btn-sm" type="button" data-session-action="close">End session</button>'
          : '<button class="btn btn-primary btn-sm" type="button" data-session-action="start">Start session</button>'}
        <a class="btn btn-ghost btn-sm" href="/admin/progress?lab=${encodeURIComponent(stats.structure.lab)}&session=${encodeURIComponent(session.id)}">View insights</a>
        <button class="btn btn-ghost btn-sm danger" type="button" data-session-action="delete">Delete</button>
      </div>
    </article>`).join('');
    list.querySelectorAll<HTMLButtonElement>('[data-session-action]').forEach((button) => button.addEventListener('click', () => {
      const row = button.closest<HTMLElement>('[data-session-id]')!;
      const action = button.dataset.sessionAction!;
      const sessionId = row.dataset.sessionId!;
      if (action === 'delete' && !confirm('Delete this session and all of its attendance and progress data? This cannot be undone.')) return;
      const taName = row.querySelector<HTMLInputElement>('[data-session-ta]')!.value;
      const timeSlot = row.querySelector<HTMLInputElement>('[data-session-slot]')!.value;
      const rawMinutes = row.querySelector<HTMLSelectElement>('[data-session-duration]')!.value;
      void sessionAction(action, { sessionId, taName, timeSlot, minutes: rawMinutes ? Number(rawMinutes) : null });
    }));
  }

  function renderAttendance(s: LabStats) {
    const board = document.querySelector<HTMLElement>('[data-lab-attendance]');
    if (!board) return;
    const checked = s.students.filter((student) => student.checkedInAt).length;
    board.querySelector<HTMLElement>('[data-att-count]')!.textContent = String(s.students.length);
    board.querySelector<HTMLElement>('[data-att-summary]')!.textContent = `${checked} checked in · ${'id' in s.session ? `${s.session.time_slot} · ${s.session.ta_name}` : 'no session selected'}`;
    board.querySelector<HTMLElement>('[data-att-lab]')!.textContent = s.structure.title;
    const insights = board.querySelector<HTMLAnchorElement>('[data-session-insights]')!;
    insights.href = `/admin/progress?lab=${encodeURIComponent(s.structure.lab)}${'id' in s.session ? `&session=${encodeURIComponent(s.session.id)}` : ''}`;
    board.querySelector<HTMLTableSectionElement>('[data-att-rows]')!.innerHTML = [...s.students]
      .sort((a, b) => Date.parse(b.lastSeen) - Date.parse(a.lastSeen))
      .map((student) => `<tr>
        <td>${esc(student.name)}</td>
        <td class="mono">${esc(student.id)}</td>
        <td class="mono faint">${esc(student.group)}</td>
        <td class="mono faint">${clock(student.startedAt)}</td>
        <td class="mono faint">${ago(student.lastSeen)}</td>
        <td class="mono">${student.percent}% · ${student.solved} solved</td>
        <td>${student.checkedInAt ? `<span class="att-state checked">✓ ${clock(student.checkedInAt)}</span>` : '<span class="faint">Not yet</span>'}</td>
      </tr>`)
      .join('');
    board.querySelector<HTMLElement>('[data-att-empty]')!.hidden = s.students.length > 0;
  }

  function render(root: HTMLElement, s: LabStats) {
    renderAttendance(s);
    const t = s.totals;
    root.dataset.lab = s.structure.lab;
    root.querySelector('[data-lab-title]')!.textContent = `${s.structure.title}${'id' in s.session ? ` · ${s.session.time_slot} · ${s.session.ta_name}` : ''}`;
    (root.querySelector('[data-open-lab]') as HTMLAnchorElement).href = `/labs/${encodeURIComponent(s.structure.lab)}`;
    root.querySelector('[data-lp-started]')!.textContent = String(t.active);
    root.querySelector('[data-lp-kpis]')!.innerHTML = [
      ['accent', t.checkedIn, 'checked in'],
      ['', t.solved, 'exercises solved'],
      ['', `${t.avgPercent}%`, 'average progress'],
      ['', t.submitted, 'repositories submitted'],
    ]
      .map(([cls, v, label]) => `<div class="kpi ${cls}"><b>${v}</b><span>${label}</span></div>`)
      .join('');

    const attempted = s.exercises.filter((exercise) => exercise.solvedPct < 100);
    const hard = attempted.sort((a, b) => a.solvedPct - b.solvedPct).slice(0, 3);
    root.querySelector('[data-lp-hardest]')!.innerHTML = hard.length
      ? hard.map((e) => {
          const meta = s.structure.exercises.find((item) => item.id === e.id);
          return `<div class="hard-chip"><b>${esc(meta?.title ?? e.id)}</b><span>${e.solvedPct}% solved · ${e.avgAttempts || 0} tries on average</span></div>`;
        }).join('')
      : '<p class="faint small">Nothing stands out yet.</p>';

    root.querySelector('[data-lp-ex]')!.innerHTML = s.exercises
      .map((e, index) => {
        const meta = s.structure.exercises.find((item) => item.id === e.id);
        return `<tr><td class="mono faint">${index + 1}</td><td>${esc(meta?.title ?? e.id)}</td><td class="mono">${e.solvedPct}%</td><td class="mono">${e.avgAttempts || '–'}</td><td class="mono">${e.medianSolveMs == null ? '–' : `${Math.round(e.medianSolveMs / 60000)} min`}</td></tr>`;
      })
      .join('');

    root.querySelector('[data-lp-st-head]')!.innerHTML = `<tr><th>Student</th><th>ID</th><th>Group</th><th>Progress</th><th>Attendance</th>${s.structure.exercises.map((e, index) => `<th class="c mono" title="${esc(e.title)}">${index + 1}</th>`).join('')}</tr>`;
    root.querySelector('[data-lp-st]')!.innerHTML = s.students
      .map(
        (st) =>
          `<tr><td>${esc(st.name)}</td><td class="mono faint">${esc(st.id)}</td><td class="mono faint">${esc(st.group)}</td><td><span class="prog"><i style="--w:${st.percent}%"></i><span class="mono">${st.percent}%</span></span></td><td>${st.attended ? '✓' : '–'}</td>${s.structure.exercises
            .map((e) => {
              const cell = st.cells[e.id];
              const state = !cell ? 'new' : cell.passed >= cell.total ? 'solved' : 'trying';
              return `<td class="c"><span class="cell ${state}" title="${esc(e.title)}: ${state}"></span></td>`;
            })
            .join('')}</tr>`,
      )
      .join('');
    (root.querySelector('[data-lp-empty]') as HTMLElement).hidden = s.students.length > 0;
  }

  async function load(root: HTMLElement) {
    const live = root.querySelector<HTMLElement>('[data-lp-live]')!;
    const attendanceLive = document.querySelector<HTMLElement>('[data-att-live]');
    try {
      const selectedSession = (document.querySelector('[data-admin-session]') as HTMLSelectElement | null)?.value ?? '';
      const res = await fetch(`/api/admin/progress?lab=${encodeURIComponent(root.dataset.lab ?? '')}${selectedSession ? `&session=${encodeURIComponent(selectedSession)}` : ''}`, { cache: 'no-store' });
      if (res.status === 401) return location.reload();
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? String(res.status));
      const stats = data as LabStats;
      const labSelect = document.querySelector<HTMLSelectElement>('[data-admin-lab]');
      const sessionSelect = document.querySelector<HTMLSelectElement>('[data-admin-session]');
      if (labSelect) {
        labSelect.replaceChildren(...stats.labs.map((lab) => new Option(lab.title, lab.id, false, lab.id === stats.structure.lab)));
        labSelect.value = stats.structure.lab;
      }
      if (sessionSelect) {
        sessionSelect.replaceChildren(...(stats.sessions.length
          ? stats.sessions.map((session) => new Option(`${session.time_slot} · ${session.ta_name}${session.open ? ' · LIVE' : ''}`, session.id, false, 'id' in stats.session && session.id === stats.session.id))
          : [new Option('No sessions yet', '')]));
        if ('id' in stats.session) sessionSelect.value = stats.session.id;
      }
      renderSessionManager(stats);
      render(root, stats);
      live.classList.add('on');
      live.textContent = `live · ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
      attendanceLive?.classList.add('on');
      if (attendanceLive) attendanceLive.textContent = live.textContent;
    } catch (error) {
      live.classList.remove('on');
      const message = error instanceof Error ? error.message : 'Could not load progress.';
      live.textContent = message.includes('set up') ? 'connect Neon in Vercel Storage' : message;
      attendanceLive?.classList.remove('on');
      if (attendanceLive) attendanceLive.textContent = live.textContent;
    }
  }

  function initTabs() {
    const root = document.querySelector<HTMLElement>('[data-labp]');
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
    if (!tabs.length) return;
    const show = (name: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== name));
      history.replaceState(null, '', name === 'att' ? location.pathname + location.search : `#${name}`);
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));
    document.querySelectorAll<HTMLButtonElement>('[data-open-sessions]').forEach((button) => button.addEventListener('click', () => show('sessions')));
    document.querySelector<HTMLSelectElement>('[data-admin-lab]')?.addEventListener('change', (event) => {
      if (!root) return;
      root.dataset.lab = (event.target as HTMLSelectElement).value;
      const sessions = document.querySelector<HTMLSelectElement>('[data-admin-session]');
      if (sessions) sessions.value = '';
      void load(root);
    });
    document.querySelector<HTMLSelectElement>('[data-admin-session]')?.addEventListener('change', () => root && void load(root));
    const create = document.querySelector<HTMLFormElement>('[data-session-create]');
    if (create && !create.dataset.wired) {
      create.dataset.wired = '1';
      create.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(create);
        const rawMinutes = String(form.get('minutes') ?? '');
        void sessionAction('create', { taName: form.get('taName'), timeSlot: form.get('timeSlot'), minutes: rawMinutes ? Number(rawMinutes) : null }).then((saved) => saved && create.reset());
      });
    }
    show(location.hash === '#lab' ? 'lab' : location.hash === '#sessions' ? 'sessions' : 'att');
    if (root) {
      void load(root);
      clearInterval(timer);
      timer = window.setInterval(() => !document.hidden && load(root), 4000);
    }
  }

  document.addEventListener('astro:page-load', initTabs);
  document.addEventListener('astro:before-swap', () => {
    clearInterval(timer);
    timer = undefined;
  });
</script>
