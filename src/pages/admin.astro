---
/**
 * Admin workspace home — generic and role-based. Shows the modules you work on (all of them for super admins,
 * the master password and doctors who create modules) with the tools your permissions allow for each, plus
 * the platform tools you manage. Signed out: account sign-in or the shared admin password.
 */
import Base from '@/layouts/Base.astro';
import AdminShell from '@/components/admin/AdminShell.astro';
import { isAdmin, setupStatus, sharedPasswordLogin } from '@/lib/attendance/server';
import { access } from '@/lib/accounts/access';
import { ROLE_NAMES } from '@/lib/accounts/permissions';
import { getAccountStore } from '@/lib/accounts/server';
import { hubData } from '@/lib/accounts/hub';

export const prerender = false;
Astro.response.headers.set('cache-control', 'no-store, max-age=0');
const staff = isAdmin(Astro.cookies);
const error = Astro.url.searchParams.get('e');
const status = setupStatus();

let view: null | {
  greeting: string; role: string; semester: string; invites: number; accounts: number;
  modules: { slug: string; title: string; code: string; color: string; href: string; builtIn: boolean; category: string; semester: string; years: string[]; labs: number; myRole: string; tools: { label: string; href: string; primary?: boolean }[] }[];
  platformTools: { label: string; href: string; desc: string; icon: string }[];
} = null;

if (staff) {
  const a = await access(Astro.cookies);
  const { cards, settings } = await hubData();
  const store = getAccountStore();
  const seeAll = a.can('platform.roles') || a.can('modules.create');
  // super admins, the master password and module-creating doctors see every module; others their own teams
  const mine = cards.filter((c) => seeAll || a.who.modules[c.slug]);
  const [invites, users] = store && a.can('accounts.staff') ? await Promise.all([store.listInvites().catch(() => []), store.list().catch(() => [])]) : [[], []];
  const hour = new Date().toLocaleString('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Africa/Cairo' });
  view = {
    greeting: `${Number(hour) < 12 ? 'Good morning' : Number(hour) < 18 ? 'Good afternoon' : 'Good evening'}${a.user ? `, ${a.user.name.split(' ')[0]}` : ''}`,
    role: a.who.platformRole ? ROLE_NAMES[a.who.platformRole] : 'Full access (admin password)',
    semester: settings.activeSemester,
    invites: invites.length,
    accounts: users.length,
    modules: mine.map((c) => {
      const mr = a.who.modules[c.slug];
      const tools: { label: string; href: string; primary?: boolean }[] = [];
      if (a.can('module.sessions', c.slug) || a.can('module.progress', c.slug)) tools.push({ label: 'Sessions', href: '/admin/sessions', primary: true });
      if (a.can('module.progress', c.slug)) tools.push({ label: 'Progress', href: '/admin/progress' });
      if (a.can('module.invite', c.slug)) tools.push({ label: 'Team & invites', href: `/admin/team/${c.slug}` });
      tools.push({ label: 'Assessment', href: `/admin/assessment/${c.slug}` });
      if (!c.builtIn && a.can('module.build', c.slug)) tools.push({ label: 'Canvas', href: `/admin/builder/${c.slug}` });
      if (c.builtIn && a.can('module.submissions', c.slug)) tools.push({ label: 'Submissions', href: '/admin/project' });
      if (c.builtIn && a.can('cms.edit')) tools.push({ label: 'Content', href: '/admin/cms' });
      return { ...c, myRole: mr ? ROLE_NAMES[mr] : a.who.platformRole ? ROLE_NAMES[a.who.platformRole] : 'Admin', tools };
    }),
    platformTools: [
      a.can('modules.create') && { label: 'New module', href: '/admin/builder', desc: 'Create a module and build its labs on the canvas', icon: '⬡' },
      a.can('platform.settings') && { label: 'Catalogue', href: '/admin/catalogue', desc: 'Years, specializations, categories, active semester', icon: '▦' },
      (a.can('accounts.manage') || a.can('accounts.staff')) && { label: 'Accounts & roles', href: '/admin/accounts', desc: 'Staff and student accounts, invitations, permissions', icon: '⚿' },
      a.can('cms.edit') && { label: 'Course content', href: '/admin/cms', desc: 'Edit the built-in course’s lists and info', icon: '✎' },
    ].filter(Boolean) as { label: string; href: string; desc: string; icon: string }[],
  };
}
---
<Base title="Admin workspace" noindex>
  {!view ? (
    <section class="ah-gate">
      <div class="ah-sky" aria-hidden="true"></div>
      <div class="glass ah-login">
        <p class="ah-k mono">Admin workspace</p>
        <h1>Sign in to manage your modules</h1>
        <a class="btn btn-primary btn-lg" href="/login?next=/admin">Sign in with your account →</a>
        {status.password && sharedPasswordLogin() && (
          <form method="post" action="/api/admin/login" class="ah-pw">
            <p class="ah-or mono">or the shared admin password</p>
            <input class="input" type="password" name="password" autocomplete="current-password" required aria-label="Admin password" placeholder="Admin password" />
            {error === 'wrong' && <p class="ah-err" role="alert">Wrong password. Try again.</p>}
            {error === 'wait' && <p class="ah-err" role="alert">Too many tries. Wait 10 minutes and try again.</p>}
            <button class="btn btn-ghost" type="submit">Open with password</button>
          </form>
        )}
      </div>
    </section>
  ) : (
    <AdminShell active="home">
      <section class="ah">
        <header class="ah-hero">
          <p class="ah-k mono">{view.role} · {view.semester} active</p>
          <h1>{view.greeting}</h1>
          <p class="muted">Everything you look after, in one place. Tools appear according to your role in each module.</p>
        </header>

        <div class="ah-stats">
          <div class="ah-stat"><span class="mono">Modules</span><b>{view.modules.length}</b><small>you work on</small></div>
          <div class="ah-stat"><span class="mono">Active semester</span><b>{view.semester.replace('Semester ', 'S')}</b><small>{view.semester}</small></div>
          {view.accounts > 0 && <div class="ah-stat"><span class="mono">Accounts</span><b>{view.accounts}</b><small>on the platform</small></div>}
          {view.invites > 0 && <a class="ah-stat warn" href="/admin/accounts"><span class="mono">Pending invites</span><b>{view.invites}</b><small>waiting to be accepted →</small></a>}
        </div>

        <section id="modules" class="ah-sec">
          <h2>Your modules</h2>
          {view.modules.length === 0 ? (
            <p class="muted">You aren't on any module team yet. A module leader or the super admin can add you.</p>
          ) : (
            <div class="ah-mods">
              {view.modules.map((m, i) => (
                <article class="ah-mod" id={`module-${m.slug}`} style={`--c:${m.color}; --i:${i}`}>
                  <span class="ah-glow" aria-hidden="true"></span>
                  <div class="ah-mtop mono"><span>{m.code || 'Module'}</span><span class="ah-role">{m.myRole}</span></div>
                  <h3><a href={m.href} target="_blank" rel="noopener">{m.title}</a></h3>
                  <p class="ah-chips mono"><span>{m.category}</span><span>{m.semester === 'Both' ? 'Both semesters' : m.semester}</span><span>{m.years.length ? m.years.join(', ') : 'All years'}</span><span>{m.labs} labs</span></p>
                  <div class="ah-tools">{m.tools.map((t) => <a class:list={['ah-tool', { pri: t.primary }]} href={t.href}>{t.label}</a>)}</div>
                </article>
              ))}
            </div>
          )}
        </section>

        {view.platformTools.length > 0 && (
          <section class="ah-sec">
            <h2>Platform</h2>
            <div class="ah-plat">
              {view.platformTools.map((t) => (
                <a class="ah-pt" href={t.href}><span class="ah-pi" aria-hidden="true">{t.icon}</span><span><b>{t.label}</b><small>{t.desc}</small></span><span aria-hidden="true">→</span></a>
              ))}
            </div>
          </section>
        )}
      </section>
    </AdminShell>
  )}
</Base>

<style>
  .ah-gate { position: relative; min-height: 100dvh; display: grid; place-items: center; padding: calc(var(--nav-h) + 40px) 16px 80px; background: var(--hero-bg); color: var(--hero-text); isolation: isolate; overflow: hidden; }
  .ah-sky { position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 20% 0%, color-mix(in oklab, #c8ff4d 28%, transparent), transparent 45%), radial-gradient(circle at 90% 100%, color-mix(in oklab, #7cb1ff 30%, transparent), transparent 45%), linear-gradient(var(--hero-grid) 1px, transparent 1px) 0 0 / 52px 52px, linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px) 0 0 / 52px 52px; }
  .ah-login { width: min(100%, 520px); padding: clamp(26px, 5vw, 44px); display: grid; gap: 16px; }
  .ah-login h1 { font-size: clamp(2rem, 1.2rem + 3vw, 3.2rem); letter-spacing: -.05em; line-height: 1; }
  .ah-pw { display: grid; gap: 10px; padding-top: 14px; border-top: 1px solid var(--hero-line); }
  .ah-pw .input { height: 46px; padding: 0 14px; background: color-mix(in oklab, var(--hero-bg) 70%, transparent); border-color: var(--hero-line); color: var(--hero-text); }
  .ah-or { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--hero-dim); }
  .ah-err { color: var(--hero-danger); font-size: 13px; }

  .ah { padding-top: calc(var(--nav-h) + 40px); padding-bottom: 100px; display: grid; gap: 30px; }
  .ah-k { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-text); }
  .ah-hero h1 { margin-top: 10px; font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.6rem); letter-spacing: -.05em; line-height: .95; }
  .ah-hero .muted { margin-top: 12px; max-width: 60ch; }
  .ah-stats { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  .ah-stat { display: grid; gap: 4px; padding: 18px; border-radius: 18px; border: 1px solid var(--line-2); background: color-mix(in oklab, var(--surface) 85%, transparent); color: var(--text); }
  .ah-stat .mono { font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-3); }
  .ah-stat b { font: 650 40px/1 var(--font-display); letter-spacing: -.04em; }
  .ah-stat small { color: var(--text-3); font-size: 12px; }
  .ah-stat.warn { border-color: color-mix(in oklab, var(--warn) 40%, var(--line-2)); }
  .ah-stat.warn b { color: var(--warn); }
  .ah-sec { display: grid; gap: 14px; }
  .ah-sec h2 { font-size: var(--fs-xl); letter-spacing: -.04em; }
  .ah-mods { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .ah-mod { position: relative; overflow: hidden; isolation: isolate; display: grid; gap: 10px; padding: 22px; border-radius: 22px; border: 1px solid color-mix(in oklab, var(--c) 35%, var(--line-2));
    background: color-mix(in oklab, var(--surface) 88%, transparent); animation: ah-in .5s var(--ease-out) both; animation-delay: calc(var(--i) * 60ms); }
  @keyframes ah-in { from { opacity: 0; transform: translateY(12px); } }
  .ah-glow { position: absolute; inset: auto -40% -70% auto; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--c) 40%, transparent), transparent 65%); z-index: -1; }
  .ah-mtop { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-3); }
  .ah-role { padding: 2px 9px; border-radius: 999px; background: color-mix(in oklab, var(--c) 22%, transparent); color: var(--text); }
  .ah-mod h3 { font-size: 1.6rem; letter-spacing: -.04em; line-height: 1.05; }
  .ah-mod h3 a:hover { color: var(--accent-text); }
  .ah-chips { display: flex; flex-wrap: wrap; gap: 6px; font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; }
  .ah-chips span { padding: 3px 8px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--text-2); }
  .ah-tools { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .ah-tool { padding: 7px 12px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--bg); font-size: 12.5px; font-weight: 600; color: var(--text); transition: border-color var(--t-fast), transform var(--t-fast); }
  .ah-tool:hover { border-color: var(--c); transform: translateY(-1px); }
  .ah-tool.pri { background: var(--c); border-color: var(--c); color: #0b0d10; }
  .ah-plat { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .ah-pt { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 18px; border-radius: 18px; border: 1px solid var(--line-2); background: color-mix(in oklab, var(--surface) 85%, transparent); color: var(--text); transition: border-color var(--t-fast), transform var(--t-fast); }
  .ah-pt:hover { border-color: var(--accent-text); transform: translateY(-2px); }
  .ah-pt b { display: block; }
  .ah-pt small { color: var(--text-3); font-size: 12.5px; }
  .ah-pi { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 40%, transparent), color-mix(in oklab, #7cb1ff 30%, transparent)); font-size: 18px; }
</style>
