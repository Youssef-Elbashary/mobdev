---
import Device from '../Device.astro';
import Icon from '../Icon.astro';
import { course } from '@/site.config';
interface Props { counts: { labs: number; coursework: number; commands: number; tools: number } }
const { counts } = Astro.props;
const quick = [
  { label: 'Labs', href: '/labs', n: counts.labs },
  { label: 'Coursework', href: '/coursework', n: counts.coursework },
  { label: 'Project', href: '/project', n: 1 },
  { label: 'Commands', href: '/commands', n: counts.commands },
  { label: 'Tools', href: '/tools', n: counts.tools },
];
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-bg hero-grid"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow hero-in" style="--d:0ms"><span class="live-dot"></span>{course.code} · Course workspace</p>
      <h1 id="hero-title" class="h-hero hero-title">
        <span class="line"><span class="hero-in" style="--d:80ms">Mobile</span></span>
        <span class="line"><span class="hero-in" style="--d:160ms">Develop<span class="accent-u">ment</span></span></span>
      </h1>
      <p class="lead hero-lead hero-in" style="--d:260ms">{course.tagline}</p>
      <div class="hero-cta hero-in" style="--d:340ms">
        <a href="#roadmap" class="btn btn-primary btn-lg">Start Learning <Icon name="arrow" class="arrow" /></a>
        <a href="/labs" class="btn btn-ghost btn-lg"><Icon name="flask" /> Explore Labs</a>
      </div>
      <nav class="hero-quick hero-in" style="--d:420ms" aria-label="Course sections">
        {quick.map((q) => (
          <a href={q.href}><span class="mono n">{String(q.n).padStart(2, '0')}</span>{q.label}</a>
        ))}
      </nav>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="stage-ring" data-depth="0.15"></div>
      <div class="stage-ring r2" data-depth="0.1"></div>

      <!-- code editor panel -->
      <div class="fl fl-code" data-depth="0.9">
        <div class="win-head"><span class="dots"><i></i><i></i><i></i></span><span class="mono">TaskRow.tsx</span></div>
        <pre class="mono code-mini"><span class="k">export function</span> <span class="f">TaskRow</span>({'{'} title {'}'}) {'{'}
  <span class="k">return</span> (
    &lt;<span class="t">Pressable</span> <span class="a">style</span>={'{'}s.row{'}'}&gt;
      &lt;<span class="t">Text</span>&gt;{'{'}title{'}'}&lt;/<span class="t">Text</span>&gt;
    &lt;/<span class="t">Pressable</span>&gt;
  );
{'}'}<span class="caret"></span></pre>
      </div>

      <!-- terminal panel -->
      <div class="fl fl-term" data-depth="0.6">
        <div class="win-head"><span class="dots"><i></i><i></i><i></i></span><span class="mono">zsh — lab-01</span></div>
        <div class="mono term">
          <p class="tl" style="--t:0"><span class="p">$</span> npx expo start</p>
          <p class="tl dim" style="--t:1">Starting Metro Bundler…</p>
          <p class="tl" style="--t:2"><span class="ok">›</span> Android Bundled <span class="dim">842ms</span></p>
          <p class="tl" style="--t:3"><span class="ok">›</span> Reloading apps<span class="caret"></span></p>
        </div>
      </div>

      <!-- git branch -->
      <div class="fl fl-git" data-depth="1.1">
        <svg viewBox="0 0 150 64" width="150" height="64">
          <path d="M8 44 H142" class="g-main" />
          <path d="M40 44 C 56 44, 56 18, 72 18 H 104 C 120 18, 120 44, 136 44" class="g-br" />
          <circle cx="20" cy="44" r="4.5" class="g-c" /><circle cx="40" cy="44" r="4.5" class="g-c" />
          <circle cx="80" cy="18" r="4.5" class="g-c b" /><circle cx="104" cy="18" r="4.5" class="g-c b" />
          <circle cx="136" cy="44" r="5.5" class="g-c m" />
        </svg>
        <span class="mono g-l">main ← feature</span>
      </div>

      <!-- api chip -->
      <div class="fl chip-fl fl-api" data-depth="1.3">
        <span class="method mono">GET</span><span class="mono">/api/tasks</span><span class="st mono">200</span>
      </div>

      <!-- build chip -->
      <div class="fl chip-fl fl-build" data-depth="1.2">
        <span class="spin"></span><span class="mono">build</span><span class="mono pass">passing</span>
      </div>

      <!-- fps -->
      <div class="fl chip-fl fl-fps" data-depth="0.8">
        <span class="mono big">60</span><span class="mono small">fps<br />UI thread</span>
      </div>

      <div class="phone-wrap" data-depth="0.35">
        <Device class="hero-device" label="Example app built during the course">
          <div class="app">
            <div class="app-head">
              <p class="app-date mono">MON · WEEK 05</p>
              <p class="app-title">Daily Focus</p>
            </div>
            <div class="app-ring">
              <svg viewBox="0 0 64 64" width="64" height="64"><circle cx="32" cy="32" r="26" class="rb" /><circle cx="32" cy="32" r="26" class="rf" /></svg>
              <div><p class="rn">3 / 5</p><p class="rl">tasks done today</p></div>
            </div>
            <ul class="app-list">
              <li class="done" style="--i:0"><span class="cb"></span>Set up emulator</li>
              <li class="done" style="--i:1"><span class="cb"></span>Build first screen</li>
              <li class="done anim" style="--i:2"><span class="cb"></span>Add navigation</li>
              <li style="--i:3"><span class="cb"></span>Fetch tasks from API <span class="pill">API</span></li>
              <li style="--i:4"><span class="cb"></span>Push to GitHub</li>
            </ul>
            <div class="app-fab">+</div>
            <nav class="app-tabs"><span class="on"></span><span></span><span></span><span></span></nav>
          </div>
        </Device>
      </div>
    </div>
  </div>

  <a href="#workspace" class="scroll-cue mono" aria-label="Scroll to workspace">
    <span>scroll</span><i></i>
  </a>
</section>

<style>
  .hero { position: relative; min-height: min(100svh, 1000px); padding-top: calc(var(--nav-h) + 28px); overflow: hidden; display: flex; flex-direction: column; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-grid { position: absolute; inset: 0; mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%); }
  .hero-glow { position: absolute; width: 900px; height: 900px; right: -200px; top: -120px; background: radial-gradient(circle, var(--accent-glow), transparent 60%); opacity: 0.35; filter: blur(40px); }
  :global(:root[data-theme='light']) .hero-glow { opacity: 0.55; }

  .hero-inner { flex: 1; display: grid; gap: 40px; align-items: center; padding-block: 32px 72px; }
  @media (min-width: 1024px) { .hero-inner { grid-template-columns: 1.08fr 1fr; gap: 24px; } }

  .hero-in { display: inline-block; opacity: 0; transform: translateY(24px); animation: hero-in 1s var(--ease-out) forwards; animation-delay: var(--d); }
  p.hero-in, div.hero-in, nav.hero-in { display: flex; }
  .hero-lead.hero-in { display: block; }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: pulse-ring 2s infinite; }
  .hero .eyebrow::before { content: none; }
  .hero-title { margin-top: 22px; }
  .hero-title .line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .accent-u { position: relative; }
  .accent-u::after { content: ''; position: absolute; left: 0.04em; right: 0.02em; bottom: 0.06em; height: 0.09em; background: var(--accent); border-radius: 2px; transform-origin: left; transform: scaleX(0); animation: underline 900ms var(--ease-out) 900ms forwards; }
  @keyframes underline { to { transform: scaleX(1); } }
  .hero-lead { margin-top: 28px; max-width: 48ch; }
  .hero-cta { margin-top: 36px; flex-wrap: wrap; gap: 12px; }
  .hero-quick { margin-top: 44px; flex-wrap: wrap; gap: 6px 22px; padding-top: 22px; border-top: 1px solid var(--line); max-width: 560px; }
  .hero-quick a { display: inline-flex; align-items: baseline; gap: 7px; font-size: 14px; color: var(--text-2); padding-block: 6px; transition: color var(--t-fast); }
  .hero-quick a:hover { color: var(--text); }
  .hero-quick .n { font-size: 11px; color: var(--accent-text); }

  /* ---- stage ---- */
  .stage { position: relative; height: 640px; display: grid; place-items: center; perspective: 1400px; }
  .stage > * { will-change: transform; }
  .phone-wrap { position: relative; z-index: 2; animation: phone-in 1.4s var(--ease-out) 200ms backwards; }
  @keyframes phone-in { from { opacity: 0; transform: translateY(60px) rotateX(18deg) rotateZ(-4deg); } }
  .hero-device { --w: 282px; transform: rotate(-3deg); }
  .stage-ring { position: absolute; width: 560px; height: 560px; border-radius: 50%; border: 1px dashed var(--line-2); opacity: 0.7; }
  .stage-ring.r2 { width: 400px; height: 400px; border-style: solid; border-color: var(--line); }

  .fl { position: absolute; z-index: 3; background: var(--surface); border: 1px solid var(--line-2); border-radius: 14px; box-shadow: var(--shadow-md); opacity: 0; animation: fl-in 900ms var(--ease-out) forwards; }
  @keyframes fl-in { from { opacity: 0; scale: 0.92; } to { opacity: 1; scale: 1; } }
  .fl > * { animation: float 7s ease-in-out infinite; }
  .win-head { display: flex; align-items: center; gap: 10px; height: 30px; padding: 0 12px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--text-3); animation: none; }
  .dots { display: inline-flex; gap: 5px; }
  .dots i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); }
  .dots i:first-child { background: #ff6b5f; } .dots i:nth-child(2) { background: #ffbd2e; } .dots i:nth-child(3) { background: #28c940; }

  .fl-code { left: -4%; top: 6%; width: 290px; animation-delay: 700ms; z-index: 1; }
  .code-mini { margin: 0; padding: 12px 14px; font-size: 11.5px; line-height: 1.65; color: var(--text-2); white-space: pre; animation: none; }
  .code-mini .k { color: #c792ea; } .code-mini .f { color: #82aaff; } .code-mini .t { color: #f07178; } .code-mini .a { color: #ffcb6b; }
  :global(:root[data-theme='light']) .code-mini .k { color: #8e3bbd; }
  :global(:root[data-theme='light']) .code-mini .f { color: #2457c5; }
  :global(:root[data-theme='light']) .code-mini .t { color: #c0352a; }
  :global(:root[data-theme='light']) .code-mini .a { color: #8a5a00; }
  .caret { display: inline-block; width: 7px; height: 13px; margin-left: 2px; vertical-align: -2px; background: var(--accent); animation: blink 1s steps(1) infinite; }

  .fl-term { right: -2%; bottom: 12%; width: 270px; animation-delay: 900ms; background: var(--code-bg); }
  .term { padding: 12px 14px; font-size: 11.5px; line-height: 1.75; animation: none; }
  .term .p { color: var(--accent-text); margin-right: 6px; }
  .term .ok { color: var(--ok); margin-right: 6px; }
  .term .dim { color: var(--text-3); }
  .tl { opacity: 0; animation: tl-in 400ms var(--ease-out) forwards; animation-delay: calc(1300ms + var(--t) * 650ms); }
  @keyframes tl-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }

  .fl-git { right: 2%; top: 10%; padding: 10px 12px 8px; display: grid; gap: 2px; animation-delay: 1100ms; }
  .fl-git svg { animation: none; }
  .g-main { stroke: var(--text-3); stroke-width: 2; fill: none; }
  .g-br { stroke: var(--accent-text); stroke-width: 2; fill: none; stroke-dasharray: 200; stroke-dashoffset: 200; animation: draw 1.6s var(--ease-out) 1.5s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  .g-c { fill: var(--surface); stroke: var(--text-3); stroke-width: 2; }
  .g-c.b { stroke: var(--accent-text); }
  .g-c.m { fill: var(--accent); stroke: var(--accent); }
  .g-l { font-size: 10.5px; color: var(--text-3); animation: none; }

  .chip-fl { display: inline-flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 999px; font-size: 11.5px; }
  .chip-fl > * { animation: none; }
  .chip-fl { animation: fl-in 900ms var(--ease-out) forwards, float 6s ease-in-out infinite; }
  .fl-api { left: 4%; bottom: 20%; animation-delay: 1300ms, 1300ms; }
  .method { color: var(--info); font-weight: 600; }
  .st { color: var(--ok); background: var(--ok-soft); padding: 1px 6px; border-radius: 6px; }
  .fl-build { left: 12%; top: 56%; animation-delay: 1500ms, 2s; display: none; }
  .spin { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--line-2); border-top-color: var(--accent-text); animation: spin 1s linear infinite; }
  .pass { color: var(--ok); }
  .fl-fps { right: 6%; top: 44%; border-radius: 14px; animation-delay: 1700ms, 1s; }
  .fl-fps .big { font-size: 20px; font-weight: 600; color: var(--text); }
  .fl-fps .small { font-size: 9.5px; line-height: 1.25; color: var(--text-3); }
  @media (min-width: 1280px) { .fl-build { display: inline-flex; } }

  /* ---- fictional app ---- */
  .app { position: absolute; inset: 0; padding: 8px 18px 0; display: flex; flex-direction: column; gap: 16px; font-family: var(--font-body); }
  .app-date { font-size: 9.5px; letter-spacing: 0.1em; color: #6f7887; }
  .app-title { font-family: var(--font-display); font-size: 26px; font-weight: 650; letter-spacing: -0.03em; line-height: 1.1; }
  .app-ring { display: flex; align-items: center; gap: 14px; padding: 12px; border-radius: 16px; background: #151920; border: 1px solid #222831; }
  .app-ring svg { transform: rotate(-90deg); flex: none; }
  .rb { fill: none; stroke: #232932; stroke-width: 7; }
  .rf { fill: none; stroke: #c8ff4d; stroke-width: 7; stroke-linecap: round; stroke-dasharray: 163.4; stroke-dashoffset: 163.4; animation: ring 1.6s var(--ease-out) 1.2s forwards; }
  @keyframes ring { to { stroke-dashoffset: 65.4; } }
  .rn { font-family: var(--font-display); font-size: 22px; font-weight: 650; }
  .rl { font-size: 11px; color: #8a93a1; }
  .app-list { list-style: none; padding: 0; display: grid; gap: 8px; }
  .app-list li { display: flex; align-items: center; gap: 10px; padding: 11px 12px; border-radius: 12px; background: #13171d; font-size: 12.5px; opacity: 0; animation: tl-in 500ms var(--ease-out) forwards; animation-delay: calc(900ms + var(--i) * 90ms); }
  .cb { width: 16px; height: 16px; flex: none; border-radius: 5px; border: 1.5px solid #3a4250; display: grid; place-items: center; }
  .done .cb { background: #c8ff4d; border-color: #c8ff4d; }
  .done .cb::after { content: ''; width: 7px; height: 4px; border: 2px solid #0a0c0f; border-top: 0; border-right: 0; rotate: -45deg; translate: 0 -1px; }
  .done { color: #6f7887; text-decoration: line-through; text-decoration-color: #3a4250; }
  .done.anim .cb { animation: check 400ms var(--ease-out) 2.6s both; }
  @keyframes check { from { background: transparent; border-color: #3a4250; } }
  .pill { margin-left: auto; font-family: var(--font-mono); font-size: 9px; padding: 2px 6px; border-radius: 6px; color: #7cb1ff; background: rgb(124 177 255 / 0.12); }
  .app-fab { position: absolute; right: 18px; bottom: 64px; width: 44px; height: 44px; border-radius: 14px; background: #c8ff4d; color: #0a0c0f; display: grid; place-items: center; font-size: 24px; font-weight: 500; box-shadow: 0 10px 30px -6px rgb(200 255 77 / 0.5); }
  .app-tabs { position: absolute; left: 0; right: 0; bottom: 0; height: 54px; display: flex; justify-content: space-around; align-items: center; padding-bottom: 12px; border-top: 1px solid #1c2129; background: #0d1014; }
  .app-tabs span { width: 18px; height: 18px; border-radius: 6px; background: #262c36; }
  .app-tabs span.on { background: #c8ff4d; }

  .scroll-cue { position: absolute; left: 50%; bottom: 20px; translate: -50% 0; display: none; flex-direction: column; align-items: center; gap: 8px; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--text-3); }
  .scroll-cue i { width: 1px; height: 36px; background: linear-gradient(var(--text-3), transparent); animation: cue 2s ease-in-out infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (min-width: 1024px) and (min-height: 820px) { .scroll-cue { display: flex; } }

  /* ---- responsive stage ---- */
  @media (max-width: 1023px) {
    .stage { height: 560px; margin-inline: calc(var(--gutter) * -1); }
    .fl-code { left: 2%; top: 2%; width: 250px; }
    .fl-term { right: 2%; bottom: 6%; width: 240px; }
  }
  @media (max-width: 640px) {
    .stage { height: 500px; }
    .hero-device { --w: 236px; }
    .stage-ring { width: 420px; height: 420px; }
    .stage-ring.r2 { width: 300px; height: 300px; }
    .fl-code, .fl-fps, .fl-build { display: none; }
    .fl-git { right: 0; top: 4%; scale: 0.85; transform-origin: top right; }
    .fl-term { right: 0; bottom: 4%; width: 210px; }
    .fl-api { left: 2%; bottom: 30%; }
    .hero-quick { gap: 4px 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in, .fl, .tl, .app-list li, .phone-wrap { opacity: 1 !important; transform: none !important; animation: none !important; }
    .rf { stroke-dashoffset: 65.4; }
    .g-br { stroke-dashoffset: 0; }
  }
</style>

<script>
  // Pointer + scroll parallax on [data-depth] layers. Transform-only, rAF-throttled.
  function init() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const layers = Array.from(hero.querySelectorAll<HTMLElement>('[data-depth]'));
    let mx = 0, my = 0, sy = 0, raf = 0;
    const fine = matchMedia('(pointer: fine)').matches;
    const paint = () => {
      raf = 0;
      layers.forEach((el) => {
        const d = Number(el.dataset.depth);
        el.style.transform = `translate3d(${mx * d * 18}px, ${my * d * 14 - sy * d * 0.12}px, 0)`;
      });
    };
    const req = () => { if (!raf) raf = requestAnimationFrame(paint); };
    const onMove = (e: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      mx = (e.clientX - r.left) / r.width - 0.5;
      my = (e.clientY - r.top) / r.height - 0.5;
      req();
    };
    const onScroll = () => { sy = Math.min(window.scrollY, 900); req(); };
    if (fine) hero.addEventListener('pointermove', onMove);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }
  document.addEventListener('astro:page-load', init);
</script>
