---
import { getRoadmap, getLabs, pad, slug } from '@/lib/content';
import EmptyState from '../EmptyState.astro';
const stages = await getRoadmap();
const labs = await getLabs();
---
<section class="section rm" id="roadmap" aria-labelledby="rm-title" data-roadmap>
  <div class="container rm-grid">
    <div class="rm-side">
      <p class="eyebrow" data-reveal>Learning roadmap</p>
      <h2 id="rm-title" class="h-2 mt-4" data-reveal>One course.<br />One path through it.</h2>
      <p class="muted mt-6" data-reveal style="max-width:36ch">Each stage builds on the last. Labs, coursework and resources are attached to the stage where you need them.</p>
      <div class="rm-meter mono" data-reveal aria-hidden="true">
        <span class="rm-meter-n" data-rm-count>01</span><span class="faint">/ {pad(stages.length)}</span>
        <div class="rm-meter-bar"><i data-rm-bar></i></div>
      </div>
    </div>

    {stages.length === 0 ? (
      <EmptyState title="The roadmap is being drawn." body="Add stages to src/content/data/roadmap.yaml." path="roadmap.yaml" />
    ) : (
      <ol class="rm-list">
        {stages.map((s, i) => {
          const stageLabs = labs.filter((l) => l.data.roadmapStage === s.id);
          const last = i === stages.length - 1;
          return (
            <li class:list={['rm-stage', { final: last }]} data-rm-stage={i}>
              <span class="rm-node mono" aria-hidden="true">{pad(i + 1)}</span>
              <div class="rm-body">
                <h3 class="h-4">{s.data.title}</h3>
                <p class="muted">{s.data.summary}</p>
                {s.data.topics.length > 0 && <p class="rm-topics">{s.data.topics.map((t) => <span class="tag">{slug(t)}</span>)}</p>}
                {(stageLabs.length > 0 || s.data.links.length > 0) && (
                  <div class="rm-links">
                    {stageLabs.map((l) => (
                      <a href={`/labs/${l.id}`} class="rm-link lab"><span class="mono">LAB {pad(l.data.number)}</span>{l.data.title}</a>
                    ))}
                    {s.data.links.map((l) => <a href={l.href} class="rm-link">{l.label} →</a>)}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</section>

<style>
  .rm-grid { display: grid; gap: 48px; }
  @media (min-width: 960px) {
    .rm-grid { grid-template-columns: 360px 1fr; gap: 80px; }
    .rm-side { position: sticky; top: calc(var(--nav-h) + 48px); align-self: start; }
  }
  .rm-meter { margin-top: 40px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .rm-meter-n { font-size: 44px; font-weight: 500; letter-spacing: -0.04em; color: var(--text); line-height: 1; }
  .rm-meter-bar { flex-basis: 100%; height: 3px; margin-top: 16px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .rm-meter-bar i { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--p, 0)); transition: transform 300ms var(--ease-out); }

  .rm-list { list-style: none; padding: 0; position: relative; }
  .rm-list::before, .rm-list::after { content: ''; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px; border-radius: 2px; background: var(--line); }
  .rm-list::after { background: linear-gradient(var(--accent), var(--accent-2)); transform-origin: top; transform: scaleY(var(--p, 0)); box-shadow: 0 0 12px var(--accent-glow); }
  .rm-stage { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 24px; padding-bottom: 44px; }
  .rm-stage:last-child { padding-bottom: 0; }
  .rm-node {
    position: relative; z-index: 1; width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center;
    background: var(--bg); border: 1px solid var(--line-2); font-size: 13px; color: var(--text-3);
    transition: all 500ms var(--ease-out);
  }
  .rm-stage.on .rm-node { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); box-shadow: 0 0 0 6px var(--accent-soft); }
  .rm-stage.final .rm-node { border-radius: 50%; }
  .rm-body { padding-top: 8px; display: grid; gap: 10px; opacity: 0.5; transition: opacity 600ms var(--ease-out); }
  .rm-stage.on .rm-body { opacity: 1; }
  .rm-topics { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .rm-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .rm-link { display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 12px; border-radius: 8px; border: 1px solid var(--line-2); font-size: 13px; color: var(--text-2); transition: all var(--t-fast); }
  .rm-link:hover { border-color: var(--accent-text); color: var(--text); }
  .rm-link.lab .mono { font-size: 10.5px; color: var(--accent-text); }
  .rm-stage.final .rm-body h3 { color: var(--accent-text); }
  @media (prefers-reduced-motion: reduce) { .rm-body { opacity: 1; } }
</style>

<script>
  import { onPageLoad } from '@/scripts/page-load';
  function init() {
    const root = document.querySelector<HTMLElement>('[data-roadmap]');
    if (!root) return;
    const stages = Array.from(root.querySelectorAll<HTMLElement>('[data-rm-stage]'));
        const bar = root.querySelector<HTMLElement>('[data-rm-bar]');
    const count = root.querySelector<HTMLElement>('[data-rm-count]');
    const list = root.querySelector<HTMLElement>('.rm-list');
    if (!list || !stages.length) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = list.getBoundingClientRect();
      const mark = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mark - r.top) / r.height));
      list.style.setProperty('--p', String(p));
      let active = 0;
      stages.forEach((s, i) => {
        const on = s.getBoundingClientRect().top < mark;
        s.classList.toggle('on', on);
        if (on) active = i + 1;
      });
      bar?.style.setProperty('--p', String(active / stages.length));
      if (count) count.textContent = String(Math.max(1, active)).padStart(2, '0');
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    update();
    addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', onScroll), { once: true });
  }
  onPageLoad( init);
</script>
