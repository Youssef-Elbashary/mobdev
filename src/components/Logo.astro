---
/** Brand mark: a device silhouette with a blinking cursor — "code, on a phone". */
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<span class="logo" style={`--sz:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 32 32" width={size} height={size}>
    <rect x="1" y="1" width="30" height="30" rx="9" class="bg" />
    <rect x="10" y="6" width="12" height="20" rx="3.2" class="dev" />
    <path d="M13.2 13.2l2 2-2 2" class="chev" />
    <rect x="16.6" y="16.4" width="3" height="1.6" rx=".6" class="cur" />
  </svg>
</span>
<style>
  .logo { display: inline-grid; width: var(--sz); height: var(--sz); }
  .bg { fill: var(--accent); }
  .dev { fill: none; stroke: var(--accent-ink); stroke-width: 1.8; }
  .chev { fill: none; stroke: var(--accent-ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cur { fill: var(--accent-ink); animation: blink 1.1s steps(1) infinite; }
</style>
