---
/**
 * Animated split bar — e.g. 60% coursework / 40% exam, or 30 / 50 / 20 marks.
 * The bar wipes in, numbers count up (see [data-count] in app.ts), legend staggers in.
 * <SplitBar items={[{ label: 'Coursework', value: 60, sub: 'team project' }]} unit="%" />
 */
interface Item { label: string; value: number; sub?: string }
interface Props { items: Item[]; unit?: string; total?: string; size?: 'md' | 'lg' }
const { items, unit = '%', total, size = 'lg' } = Astro.props;
const COLORS = ['var(--accent)', '#7cb1ff', '#ffb547', '#ff8ad8'];
const INK = ['var(--accent-ink)', '#08111f', '#1d1200', '#2a0620'];
const sum = items.reduce((a, i) => a + i.value, 0);
---
<figure class:list={['split', size]} data-reveal role="img" aria-label={items.map((i) => `${i.label}: ${i.value}${unit}`).join(', ')}>
  <div class="split-big" aria-hidden="true">
    {items.map((it, i) => (
      <div class="big-item" style={`--c:${COLORS[i % 4]}; --i:${i}`}>
        <span class="big-n"><b data-count={it.value}>{it.value}</b><small>{unit}</small></span>
        <span class="big-l">{it.label}</span>
        {it.sub && <span class="big-s mono">{it.sub}</span>}
      </div>
    ))}
  </div>
  <div class="split-bar" aria-hidden="true">
    {items.map((it, i) => (
      <span class="seg" style={`flex:${it.value}; --c:${COLORS[i % 4]}; --ink:${INK[i % 4]}; --i:${i}`}>
        <span class="seg-v mono">{it.value}{unit === '%' ? '%' : ''}</span>
      </span>
    ))}
  </div>
  <div class="split-scale mono" aria-hidden="true"><span>0</span><span>{total ?? `${sum}${unit === '%' ? '%' : ` ${unit}`}`}</span></div>
</figure>

<style>
  .split { margin-inline: 0; margin-bottom: 0; display: grid; gap: 16px; }
  .split-big { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px 24px; }
  .big-item { display: grid; gap: 2px; padding-left: 14px; border-left: 3px solid var(--c); }
  :global(:root[data-theme='light']) .big-item:first-child { border-left-color: var(--accent-text); }
  .big-n { display: flex; align-items: baseline; gap: 2px; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.05em; line-height: 1; color: var(--text); }
  .lg .big-n b { font-size: clamp(48px, 7vw, 76px); }
  .md .big-n b { font-size: clamp(36px, 5vw, 52px); }
  .big-n small { font-size: 0.4em; font-weight: 600; color: var(--text-3); letter-spacing: 0; margin-left: 2px; }
  .lg .big-n small { font-size: 22px; }
  .md .big-n small { font-size: 16px; }
  .big-l { font-weight: 600; color: var(--text); margin-top: 6px; }
  .big-s { font-size: 11.5px; color: var(--text-3); }
  .split-bar { display: flex; gap: 4px; height: 52px; border-radius: 14px; overflow: hidden; background: var(--line); clip-path: inset(0 100% 0 0 round 14px); }
  .md .split-bar { height: 40px; border-radius: 10px; }
  .seg { position: relative; display: flex; align-items: center; padding: 0 14px; background: var(--c); color: var(--ink); overflow: hidden; }
  .seg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 20%, rgb(255 255 255 / 0.45) 50%, transparent 80%); transform: translateX(-120%); }
  .seg-v { font-size: 13px; font-weight: 700; position: relative; z-index: 1; opacity: 0; }
  .split-scale { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-3); }

  /* motion */
  .split .big-item { opacity: 0; transform: translateY(12px); }
  .split.in .big-item { animation: sb-up 700ms var(--ease-out) forwards; animation-delay: calc(var(--i) * 160ms); }
  .split.in .split-bar { animation: sb-wipe 1400ms var(--ease-out) 150ms forwards; }
  .split.in .seg::after { animation: sb-shine 1100ms var(--ease-out) forwards; animation-delay: calc(1300ms + var(--i) * 180ms); }
  .split.in .seg-v { animation: sb-fade 500ms var(--ease-out) forwards; animation-delay: calc(900ms + var(--i) * 200ms); }
  @keyframes sb-wipe { to { clip-path: inset(0 0 0 0 round 14px); } }
  @keyframes sb-shine { to { transform: translateX(120%); } }
  @keyframes sb-fade { to { opacity: 1; } }
  @keyframes sb-up { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .split-bar { clip-path: none; }
    .split .big-item, .seg-v { opacity: 1; transform: none; animation: none !important; }
  }
</style>
