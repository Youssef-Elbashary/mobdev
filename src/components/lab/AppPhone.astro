---
/**
 * Phone showing the Lab 01 app. `markers` numbers the 5 UI basics
 * (a list written right after it becomes the legend).
 * <AppPhone markers /> · <AppPhone name="Mariam" count={3} footer="Made by Mariam" /> · <AppPhone blank />
 */
import Device from '../Device.astro';
import reactLogo from '@/assets/tools/react.svg';
interface Props { markers?: boolean; name?: string; count?: number; footer?: string; blank?: boolean; size?: number; caption?: string; plain?: boolean }
const { markers = false, name = '', count = 0, footer, blank = false, size = 250, caption, plain = false } = Astro.props;
---
<figure class:list={['aphone', { 'legend-host': markers }]} data-reveal={plain ? undefined : true} style={`--phone-w:${size}px`}>
  <Device light label={blank ? 'Phone showing the blank starter screen' : `Phone showing the Lab 01 app${footer ? ' with footer text' : ''}`}>
    {blank ? (
      <div class="ap-blank"><p>Edit app/index.tsx to edit this screen.</p></div>
    ) : (
      <div class:list={['ap', 'mk-host', { outlined: markers }]}>
        {markers && <i class="mk left" style="--n:0">1</i>}
        <span class="ap-el stg mk-host" style="--i:0"><img src={reactLogo.src} alt="" class="ap-logo" width="46" height="46" />{markers && <i class="mk" style="--n:1">2</i>}</span>
        <span class="ap-el stg mk-host ap-title" style="--i:1">Hello, {name || 'Mobile Dev'} 👋{markers && <i class="mk" style="--n:2">3</i>}</span>
        <span class:list={['ap-el', 'stg', 'mk-host', 'ap-input', { filled: !!name }]} style="--i:2">{name || 'Type your name…'}{markers && <i class="mk" style="--n:3">4</i>}</span>
        <span class="ap-el stg mk-host ap-btn" style="--i:3">Tapped <b data-count={count}>{count}</b> times{markers && <i class="mk" style="--n:4">5</i>}</span>
        {footer && <span class="ap-el stg ap-footer" style="--i:4">{footer}</span>}
      </div>
    )}
  </Device>
  {caption && <figcaption class="ap-cap mono">{caption}</figcaption>}
</figure>

<style>
  .aphone { margin-inline: 0; margin-bottom: 0; display: grid; justify-items: center; gap: 12px; }
  .aphone :global(.device) { --w: var(--phone-w); }
  .ap { position: absolute; inset: 4px 12px 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; border-radius: 16px; }
  .ap.outlined { outline: 2px dashed color-mix(in oklab, #7cb1ff 70%, transparent); outline-offset: -2px; }
  .ap-el { position: relative; }
  .ap-logo { width: 46px; height: 46px; }
  .ap-title { font-weight: 700; font-size: 19px; color: #11181c; letter-spacing: -0.01em; }
  .ap-input { align-self: stretch; padding: 9px 11px; border: 1px solid #ccc; border-radius: 9px; font-size: 13px; color: #9aa0a6; }
  .ap-input.filled { color: #11181c; border-color: #7cb1ff; }
  .ap-btn { padding: 10px 16px; border-radius: 9px; background: #111; color: #fff; font-size: 13px; font-weight: 600; }
  .ap-btn b { font-variant-numeric: tabular-nums; }
  .ap-footer { font-size: 12px; color: #6b7280; padding: 4px 10px; border-radius: 999px; background: #f1f5f9; }
  .aphone .ap-footer { box-shadow: 0 0 0 0 rgb(200 255 77 / 0.9); }
  :global([data-reveal].in) .ap-footer { animation: stg-in 700ms var(--ease-out) forwards 500ms, ap-glow 1.6s var(--ease-out) 1.1s; }
  @keyframes ap-glow { 0% { box-shadow: 0 0 0 0 rgb(163 230 53 / 0.9); } 100% { box-shadow: 0 0 0 14px rgb(163 230 53 / 0); } }
  .ap-blank { position: absolute; inset: 0; display: grid; place-items: center; padding: 20px; text-align: center; font-size: 13px; color: #11181c; }
  .ap-cap { font-size: 11.5px; color: var(--text-3); text-align: center; }
  .ap .mk { top: -8px; right: -12px; }
  .ap > .mk.left { top: 6px; left: 6px; }
</style>
