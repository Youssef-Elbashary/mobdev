---
/**
 * Git flow diagram: main line + one branch that merges back.
 * Steps: [{ label, where: 'laptop' | 'github' | 'both', lane: 'main' | 'branch', cmd? }]
 * `current` highlights one step ("you are here"); `compact` hides the step labels.
 */
import Icon from '../Icon.astro';
interface Step { label: string; where: 'laptop' | 'github' | 'both' | 'down'; lane: 'main' | 'branch'; cmd?: string }
interface Props { steps: Step[]; current?: number; compact?: boolean; branch?: string }
const { steps, current, compact = false, branch = 'feature' } = Astro.props;
const n = steps.length;
const W = 100 * n;
const x = (i: number) => 50 + i * 100;
const y = (s: Step) => (s.lane === 'branch' ? 34 : 96);
// main line through all main-lane nodes; branch path from the node before the first branch step to the node after the last
const firstB = steps.findIndex((s) => s.lane === 'branch');
const lastB = steps.map((s) => s.lane).lastIndexOf('branch');
let branchD = '';
if (firstB > 0 && lastB >= firstB) {
  const sx = x(firstB - 1), ex = x(Math.min(lastB + 1, n - 1));
  branchD = `M${sx} 96 C ${sx + 50} 96, ${x(firstB) - 50} 34, ${x(firstB)} 34 L ${x(lastB)} 34 C ${x(lastB) + 50} 34, ${ex - 50} 96, ${ex} 96`;
}
const whereLabel = { laptop: 'Your laptop', github: 'On GitHub', both: 'Laptop → GitHub', down: 'GitHub → laptop' };
---
<figure class:list={['gflow', { compact }]} data-reveal aria-label={`Git steps: ${steps.map((s, i) => `${i + 1}. ${s.label}`).join('; ')}`}>
  <div class="gf-graph">
    <svg viewBox={`0 0 ${W} 130`} class="gf-svg" aria-hidden="true">
      <text x="8" y="120" class="gf-lane">main</text>
      {firstB > 0 && <text x={x(firstB) - 30} y="16" class="gf-lane br">{branch}</text>}
      <path d={`M 20 96 H ${W - 20}`} class="gf-main" pathLength="1" />
      {branchD && <path d={branchD} class="gf-br" pathLength="1" />}
      {steps.map((s, i) => (
        <g class:list={['gf-node', s.lane, { cur: current === i + 1, past: current !== undefined && i + 1 < current }]} style={`--i:${i}`} transform={`translate(${x(i)} ${y(s)})`}>
          {current === i + 1 && <circle r="24" class="gf-pulse" />}
          <circle r="15" />
          <text y="5">{i + 1}</text>
        </g>
      ))}
    </svg>
    {current && <span class="gf-here mono" style={`--x:${(current - 0.5) / n}`}>you are here</span>}
  </div>
  {!compact && (
    <ol class="gf-steps" style={`--n:${n}`}>
      {steps.map((s, i) => (
        <li class:list={['gf-step', s.lane, { cur: current === i + 1 }]} style={`--i:${i}`}>
          <span class="gf-num mono" aria-hidden="true">{i + 1}</span>
          <span class="gf-label">{s.label}</span>
          <span class="gf-where mono" title={whereLabel[s.where]}>
            {s.where === 'laptop' && <><Icon name="laptop" size={14} /><span>laptop</span></>}
            {s.where === 'github' && <><Icon name="cloud" size={14} /><span>GitHub</span></>}
            {s.where === 'both' && <><Icon name="laptop" size={14} /><span class="gf-arr">→</span><Icon name="cloud" size={14} /></>}
            {s.where === 'down' && <><Icon name="cloud" size={14} /><span class="gf-arr">→</span><Icon name="laptop" size={14} /></>}
            <span class="sr-only">{whereLabel[s.where]}</span>
          </span>
          {s.cmd && <code class="gf-cmd">{s.cmd}</code>}
        </li>
      ))}
    </ol>
  )}
</figure>

<style>
  .gflow { margin-inline: 0; margin-bottom: 0; padding: 18px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--surface); }
  .gflow.compact { padding: 10px 14px; background: transparent; }
  .gf-graph { position: relative; }
  .gf-svg { width: 100%; height: auto; overflow: visible; }
  .gf-lane { font: 600 11px var(--font-mono); fill: var(--text-3); letter-spacing: 0.05em; }
  .gf-lane.br { fill: var(--accent-text); }
  .gf-main, .gf-br { fill: none; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .gf-main { stroke: var(--line-2); }
  .gf-br { stroke: var(--accent-text); }
  .gf-node circle:not(.gf-pulse) { fill: var(--bg); stroke: var(--line-2); stroke-width: 3; transition: fill 300ms, stroke 300ms; }
  .gf-node.branch circle:not(.gf-pulse) { stroke: var(--accent-text); }
  .gf-node text { font: 700 13px var(--font-mono); text-anchor: middle; fill: var(--text-2); }
  .gf-node.cur circle:not(.gf-pulse), .gf-node.past circle:not(.gf-pulse) { fill: var(--accent); stroke: var(--accent); }
  .gf-node.cur text, .gf-node.past text { fill: var(--accent-ink); }
  :global(:root[data-theme='light']) .gf-node.cur text, :global(:root[data-theme='light']) .gf-node.past text { fill: #0e1013; }
  .gf-pulse { fill: var(--accent-glow); animation: gf-pulse 1.8s ease-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes gf-pulse { 0% { opacity: 0.9; transform: scale(0.6); } 100% { opacity: 0; transform: scale(1.4); } }
  .gf-here { position: absolute; left: calc(var(--x) * 100%); top: -6px; translate: -50% -100%; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; background: var(--accent); color: var(--accent-ink); white-space: nowrap; }
  .gf-steps { list-style: none; padding: 0 !important; margin: 14px 0 0 !important; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 8px; }
  .gf-step { display: grid; justify-items: center; align-content: start; gap: 4px; text-align: center; margin: 0 !important; padding: 0 !important; }
  .gf-num { display: none; }
  .gf-label { font-size: 13px; font-weight: 600; color: var(--text); line-height: 1.3; }
  .gf-step.cur .gf-label { color: var(--accent-text); }
  .gf-where { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; color: var(--text-3); white-space: nowrap; }
  .gf-where :global(svg) { flex: none; }
  .gf-arr { color: var(--accent-text); }
  .gf-cmd { font-size: 11px !important; white-space: nowrap; }

  /* motion */
  .gflow.in .gf-main { transition: stroke-dashoffset 1.1s var(--ease-out) 100ms; stroke-dashoffset: 0; }
  .gflow.in .gf-br { transition: stroke-dashoffset 1.3s var(--ease-out) 700ms; stroke-dashoffset: 0; }
  .gflow .gf-node { opacity: 0; }
  .gflow.in .gf-node { animation: gf-pop 500ms var(--ease-out) forwards; animation-delay: calc(300ms + var(--i) * 220ms); }
  @keyframes gf-pop { from { opacity: 0; } to { opacity: 1; } }
  .gflow .gf-step { opacity: 0; transform: translateY(8px); }
  .gflow.in .gf-step { animation: stg-in 600ms var(--ease-out) forwards; animation-delay: calc(450ms + var(--i) * 220ms); }

  /* phones: vertical subway map */
  @media (max-width: 719px) {
    .gflow:not(.compact) .gf-graph { display: none; }
    .gf-steps { grid-template-columns: 1fr; gap: 0; margin: 0 !important; }
    .gf-step { position: relative; grid-template-columns: 32px 1fr; justify-items: start; text-align: left; column-gap: 12px; row-gap: 2px; padding: 8px 0 8px 0 !important; }
    .gf-step::before { content: ''; position: absolute; left: 15px; top: 0; bottom: 0; width: 3px; background: var(--line-2); }
    .gf-step:first-child::before { top: 50%; }
    .gf-step:last-child::before { bottom: 50%; }
    .gf-step.branch { padding-left: 24px !important; }
    .gf-step.branch::before { left: 39px; background: var(--accent-text); }
    .gf-num { position: relative; z-index: 1; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--bg); border: 3px solid var(--line-2); font-size: 12px; font-weight: 700; color: var(--text-2); grid-row: span 3; }
    .gf-step.branch .gf-num { border-color: var(--accent-text); }
    .gf-step.cur .gf-num { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
    .gf-label, .gf-where, .gf-cmd { grid-column: 2; }
    .gflow.compact .gf-graph { margin-top: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gf-main, .gf-br { stroke-dashoffset: 0; }
    .gflow .gf-node { opacity: 1; animation: none; }
    .gflow .gf-step { opacity: 1; transform: none; animation: none; }
    .gf-pulse { animation: none; opacity: 0.4; }
  }
</style>
