---
/** Part banner — groups tasks. <Part n="1" title="Meet the course" time="10 min" /> */
interface Props { n: string | number; title: string; time?: string }
const { n, title, time } = Astro.props;
const num = String(n).padStart(2, '0');
---
<section class="part" id={`part-${n}`} data-reveal>
  <div class="part-num" aria-hidden="true"><span class="mono">PART</span><b>{num}</b></div>
  <div class="part-main">
    <h2 class="part-title"><span class="sr-only">Part {n}: </span>{title}</h2>
    {time && (
      <p class="part-time mono">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l2 2M9 2h6" /></svg>
        {time}
      </p>
    )}
  </div>
  <span class="part-line" aria-hidden="true"></span>
</section>

<style>
  .part {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: end;
    margin: 96px 0 28px; padding-bottom: 20px; scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .part:first-child { margin-top: 0; }
  .part-num { display: grid; line-height: 0.8; }
  .part-num .mono { font-size: 11px; letter-spacing: 0.2em; color: var(--text-3); margin-bottom: 8px; }
  .part-num b {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(64px, 9vw, 104px); letter-spacing: -0.06em;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent-text);
    background: linear-gradient(var(--accent), var(--accent)) no-repeat left bottom / 100% 0%;
    -webkit-background-clip: text; background-clip: text;
    transition: background-size 1.1s var(--ease-out) 200ms;
  }
  .part.in .part-num b { background-size: 100% 100%; }
  .part-title { font-size: var(--fs-2xl); letter-spacing: -0.035em; color: var(--text); margin: 0 !important; }
  .part-time { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px !important; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line-2); font-size: 12px; color: var(--text-2); }
  .part-line { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--line); overflow: hidden; }
  .part-line::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--accent), transparent); transform: scaleX(0); transform-origin: left; transition: transform 1.2s var(--ease-out) 300ms; }
  .part.in .part-line::after { transform: scaleX(1); }
  @media (max-width: 560px) { .part { grid-template-columns: 1fr; gap: 8px; margin-top: 72px; } }
</style>
