---
/** The "Connect to GitHub" window (Git Credential Manager) that appears on the first push on Windows. */
import MockFrame from './MockFrame.astro';
---
<MockFrame window="Git Credential Manager" label="Connect to GitHub window with Browser/Device and Token tabs, a Personal access token field and a Sign in button">
  <div class="gh-grid" style="max-width:340px;margin-inline:auto;text-align:center;gap:16px">
    <div style="display:grid;justify-items:center;gap:6px">
      <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      <p class="gh-h">Connect to GitHub</p>
    </div>
    <div class="mk-host"><div class="gh-tabs" style="justify-content:center"><span>Browser/Device</span><span class="on">Token</span></div><i class="mk" style="--n:0">1</i></div>
    <div class="gh-field mk-host" style="text-align:left"><span class="gh-label">Personal access token</span><span class="gh-input focus">••••••••••••••••••••••••••••</span><i class="mk" style="--n:1">2</i></div>
    <span class="gh-btn green mk-host" style="justify-content:center;height:36px">Sign in<i class="mk" style="--n:2">3</i></span>
    <p class="gh-hint">Don't have an account? <span class="gh-link">Sign up</span></p>
  </div>
</MockFrame>
