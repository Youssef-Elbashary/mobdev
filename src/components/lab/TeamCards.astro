---
/** Teaching team cards — data from `team` in src/site.config.ts. <TeamCards /> */
import { team } from '@/site.config';
const initials = (n: string) => n.replace(/^Dr\.\s*/, '').split(' ').map((w) => w[0]).join('').slice(0, 2);
const HUES = ['#c8ff4d', '#7cb1ff', '#ffb547', '#ff8ad8'];
---
<div class="team-grid" data-reveal>
  {team.map((m, i) => (
    <a href={`mailto:${m.email}`} class:list={['tc', 'stg', { lead: i === 0 }]} style={`--i:${i}; --h:${HUES[i % 4]}`}>
      <span class="tc-av mono" aria-hidden="true">{initials(m.name)}</span>
      <span class="tc-role mono">{m.role}</span>
      <span class="tc-name">{m.name}</span>
      <span class="tc-mail mono">{m.email}</span>
    </a>
  ))}
</div>

<style>
  .team-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .tc { position: relative; display: grid; gap: 4px; padding: 18px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--surface); text-decoration: none !important; overflow: hidden; transition: transform var(--t-med) var(--ease-out), border-color var(--t-med); }
  .tc::before { content: ''; position: absolute; right: -40px; top: -40px; width: 110px; height: 110px; border-radius: 50%; background: radial-gradient(circle, color-mix(in oklab, var(--h) 35%, transparent), transparent 70%); }
  .tc:hover { transform: translateY(-3px); border-color: var(--h); }
  .tc-av { position: relative; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 10px; background: var(--h); color: #0a0c0f; font-weight: 700; font-size: 15px; }
  .tc.lead .tc-av { box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--h); }
  .tc-role { font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
  .tc-name { font-weight: 650; color: var(--text); font-size: 1.02rem; }
  .tc-mail { font-size: 11.5px; color: var(--text-3); overflow-wrap: anywhere; }
  .tc:hover .tc-mail { color: var(--accent-text); }
</style>
