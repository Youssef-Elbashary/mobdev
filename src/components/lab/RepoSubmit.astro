---
/**
 * The student pastes their GitHub repository link; the TA sees it in /admin/progress.
 * <RepoSubmit lab="lab-02" />  (its presence also makes the repo count toward progress)
 */
interface Props { lab: string; placeholder?: string }
const { lab, placeholder = 'https://github.com/your-username/movies-app' } = Astro.props;
---
<div class="repo" data-repo-submit data-lab={lab} data-reveal>
  <form class="repo-form" novalidate>
    <label class="repo-l" for={`repo-${lab}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.7 5.38-5.27 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      Submit your repository
    </label>
    <div class="repo-row">
      <input class="input mono" id={`repo-${lab}`} type="url" inputmode="url" autocomplete="off" placeholder={placeholder} data-repo-url required />
      <button class="btn btn-primary" type="submit" data-repo-send>Submit</button>
    </div>
    <p class="repo-msg" data-repo-msg role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  .repo { padding: 18px; border-radius: var(--r-lg); border: 1px solid var(--line); background: linear-gradient(160deg, var(--accent-soft), var(--surface) 60%); }
  .repo-form { display: grid; gap: 10px; }
  .repo-l { display: flex; align-items: center; gap: 8px; font-weight: 650; color: var(--text); }
  .repo-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .repo-row .input { flex: 1 1 240px; min-width: 0; height: 46px; padding-left: 14px; font-size: 14px; border-radius: 12px; }
  .repo-msg { min-height: 1.4em; margin: 0 !important; font-size: 13.5px; color: var(--text-3); }
  .repo[data-state='done'] { border-color: color-mix(in oklab, var(--ok) 50%, var(--line)); }
  .repo[data-state='done'] .repo-msg { color: var(--ok); font-weight: 600; }
  .repo[data-state='error'] .repo-msg { color: var(--danger); }
</style>
