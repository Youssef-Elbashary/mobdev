---
/** Shown instead of an invitation-only module (or its labs) to someone who isn't enrolled. */
interface Props { title: string; code?: string; color?: string; description?: string; signedIn: boolean; next: string }
const { title, code, color = '#7cb1ff', description, signedIn, next } = Astro.props;
---
<section class="lk" style={`--c:${color}`}>
  <div class="lk-sky" aria-hidden="true"></div>
  <div class="container lk-in glass">
    <span class="lk-ic" aria-hidden="true">🔒</span>
    <p class="lk-k mono">{code || 'Module'} · invitation only</p>
    <h1>{title}</h1>
    {description && <p class="lk-d">{description}</p>}
    <p class="lk-why">You join this module through an <b>invitation from its module leader</b>, or when the teaching team enrols you. {signedIn ? 'Your account is not enrolled yet.' : 'If you were enrolled, sign in with that email.'}</p>
    <div class="lk-act">
      {!signedIn && <a class="btn btn-primary" href={`/login?next=${encodeURIComponent(next)}`}>Sign in</a>}
      <a class="btn btn-ghost" href="/">Your modules</a>
      <a class="btn btn-ghost" href="/modules">Find a module</a>
    </div>
  </div>
</section>

<style>
  .lk { position: relative; min-height: 100dvh; display: grid; place-items: center; padding: calc(var(--nav-h) + 40px) 0 80px; background: var(--hero-bg); color: var(--hero-text); isolation: isolate; overflow: hidden; }
  .lk-sky { position: absolute; inset: 0; z-index: -1; background: radial-gradient(circle at 50% 0%, color-mix(in oklab, var(--c) 40%, transparent), transparent 55%), linear-gradient(var(--hero-grid) 1px, transparent 1px) 0 0 / 52px 52px, linear-gradient(90deg, var(--hero-grid) 1px, transparent 1px) 0 0 / 52px 52px; }
  .lk-in { max-width: 680px; padding: clamp(28px, 5vw, 48px); display: grid; gap: 14px; justify-items: start; }
  .lk-ic { font-size: 34px; filter: drop-shadow(0 0 18px var(--c)); }
  .lk-k { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--hero-accent); }
  h1 { font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4rem); letter-spacing: -.05em; line-height: .95; }
  .lk-d, .lk-why { color: var(--hero-lead); }
  .lk-why b { color: var(--hero-text); }
  .lk-act { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
</style>
