---
import Logo from './Logo.astro';
import InstitutionBrand from './InstitutionBrand.astro';
import { course, nav, secondaryNav, platform } from '@/site.config';
// Inside the built-in course the footer lists its sections; elsewhere (module chooser, builder modules,
// sign-in, admin) it stays platform-level, so students choose a module first.
const path = Astro.url.pathname;
const inCourse = /^\/(course|labs|coursework|project|commands|tools|setup|resources|troubleshooting|extra|submit|attendance)(\/|$)/.test(path);
const groups = inCourse
  ? [
      { title: 'Learn', links: nav.slice(1, 4) },
      { title: 'Build', links: nav.slice(4, 7) },
      { title: 'Help', links: [nav[7], ...secondaryNav] },
    ]
  : [{ title: 'Platform', links: [{ label: 'Choose a module', href: '/' }, { label: 'All modules', href: '/modules' }, { label: 'Sign in', href: '/login' }] }];
---
<footer class="footer">
  <div class="container">
    <div class="f-top">
      <div class="f-brand">
        <a href="/" class="f-logo"><Logo size={36} /><span>{platform.name}</span></a>
        <InstitutionBrand />
        <p class="f-institution">{course.university}</p>
        <p class="muted">{inCourse
          ? `${course.name}: labs, coursework, project, commands, tools and setup, in one place.`
          : `${platform.tagline}: every module's labs, live sessions, attendance and progress in one place.`}</p>
        <div class="f-status mono"><span class="pulse"></span> {inCourse ? `${course.code} · ${course.term}` : course.term}</div>
      </div>
      {groups.map((g) => (
        <nav aria-label={g.title} class="f-col">
          <p class="eyebrow no-slash">{g.title}</p>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="f-mark" aria-hidden="true">{inCourse ? <>mobile<span>/</span>dev</> : <>lab<span>/</span>verse</>}</div>
    <div class="f-bottom mono">
      {inCourse ? <span>Module leader: {course.instructor} · <a href="/course#team">Teaching team</a></span> : <span>{platform.name} · {platform.tagline}</span>}
      <span>Built for students and teaching teams</span>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-top: 72px; overflow: hidden; background: var(--bg-2); }
  .f-top { display: grid; gap: 40px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .f-top { grid-template-columns: 1.6fr repeat(3, 1fr); } }
  .f-brand { grid-column: 1 / -1; display: grid; gap: 16px; max-width: 380px; align-content: start; }
  @media (min-width: 900px) { .f-brand { grid-column: auto; } }
  .f-logo { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: 650; font-size: 20px; letter-spacing: -0.02em; }
  .f-institution { max-width: 34ch; font-size: 13px; font-weight: 650; line-height: 1.45; color: var(--accent-text); }
  .f-status { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; color: var(--text-3); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse-ring 2s infinite; }
  .f-col ul { list-style: none; padding: 0; margin-top: 16px; display: grid; gap: 10px; }
  .f-col a { color: var(--text-2); font-size: 14.5px; transition: color var(--t-fast); }
  .f-col a:hover { color: var(--accent-text); }
  .f-mark {
    margin-top: 64px; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.06em; line-height: 0.8;
    font-size: clamp(64px, 17vw, 250px); color: transparent; -webkit-text-stroke: 1px var(--line-2); user-select: none; white-space: nowrap;
  }
  .f-mark span { -webkit-text-stroke: 0; color: var(--accent); }
  .f-bottom { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 24px; border-top: 1px solid var(--line); font-size: 12px; color: var(--text-3); }
</style>
