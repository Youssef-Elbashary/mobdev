# Explicit override. If omitted: local=development, Vercel Preview=staging, Vercel Production=production.
APP_ENV=development

# Local development database.
LOCAL_DATABASE_URL=postgresql://mobdev:mobdev@127.0.0.1:55432/mobdev

# Base names work with Vercel's environment scoping. Optional suffixed names override them per environment.
DATABASE_URL=
DATABASE_URL_DEVELOPMENT=
DATABASE_URL_STAGING=
DATABASE_URL_PRODUCTION=
BLOB_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN_DEVELOPMENT=
BLOB_READ_WRITE_TOKEN_STAGING=
BLOB_READ_WRITE_TOKEN_PRODUCTION=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
ADMIN_PASSWORD=
